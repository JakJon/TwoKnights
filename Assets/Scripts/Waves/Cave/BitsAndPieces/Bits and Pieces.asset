%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0f63b6399a5b391ce7a68be01483f175, type: 3}
  m_Name: Bits and Pieces
  m_EditorClassIdentifier: 
  waveName: Bits and Pieces
  weight: 1000
  isUnlocked: 0
  waveDescription: Powder on the outer rail, gnomes on the inner. Pick your keg.
  unlockedAfterXWaves: 0
  lockedAfterXWaves: 6
  useEnemyTracking: 1
  railLayout: {fileID: 11400000, guid: 40e9dc310ff2cf24a33b8d77298aa84c, type: 2}
  gnomeCarts:
  - {fileID: 8840196627819282881, guid: 8b69864c61374ea4f8037b11251aee4a, type: 3}
  kegCart: {fileID: 7175986229030684091, guid: 4d2163450dde86844bb1490e53e82346, type: 3}
  ambushes:
  - label: shift 1 (3 riders, 2 kegs)
    gnomesPerAmbush: 3
    kegsPerAmbush: 2
    leadIn: 0.75
    releasePause: 1
  - label: shift 2 (4 riders, 3 kegs)
    gnomesPerAmbush: 4
    kegsPerAmbush: 3
    leadIn: 1.5
    releasePause: 1
  highOrbs:
    healthOrb: 0
    count: 1
    firstAt: 10
    interval: 14
    from: {x: -12, y: 4.3}
    to: {x: 12, y: 4.3}
  lowOrbs:
    healthOrb: 0
    count: 1
    firstAt: 20
    interval: 14
    from: {x: 12, y: -5}
    to: {x: -12, y: -5}
  ogres:
    label: 1 with every shift, down and up the empty middle
    count: 1
    firstAt: 3
    interval: 4
    throwStagger: 0
    fireEveryNth: 3
    entries:
    - label: down the empty middle, left of centre
      at: {x: -4, y: 8}
      mark: 1
    - label: up the empty middle, right of centre
      at: {x: 4, y: -8}
      mark: 2
    - label: up the empty middle, left of centre
      at: {x: -4, y: -8}
      mark: 1
    - label: down the empty middle, right of centre
      at: {x: 4, y: 8}
      mark: 2
    startOnRight: 0
    entryX: 11
    entryY: -0.5
    laneStep: 1.1
  volleys:
  - label: spread on the left
    shape: 4
    rightKnight: 0
    fromBelow: 0
    spacing: 1
    count: 3
    fanDegrees: 55
    salvo: 1
    salvoSpread: 0.45
    salvoStagger: 0.29
    restAfter: 5
  - label: spread on the right
    shape: 4
    rightKnight: 1
    fromBelow: 0
    spacing: 1
    count: 3
    fanDegrees: 55
    salvo: 1
    salvoSpread: 0.45
    salvoStagger: 0.25
    restAfter: 5
  projectileWindow: 30
  rockSpeed: 1.75
