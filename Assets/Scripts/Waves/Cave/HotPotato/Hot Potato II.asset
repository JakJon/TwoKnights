        mark: 2
      - label: over the top, right of centre, walking at the left knight
        at: {x: 4.5, y: 6.5}
        mark: 1
      - label: over the top, in the middle, walking at the right knight
        at: {x: 0, y: 6.5}
        mark: 2
      startOnRight: 0
      entryX: 11
      entryY: -0.5
      laneStep: 1.1
    firstVolleyAt: 3
    volleys:
    - label: both knights spiral from underneath, mirrored
      shape: 9
      rightKnight: 0
      fromBelow: 1
      spacing: 0.4
      count: 6
      fanDegrees: 60
      weaveDegrees: 90
      spiralDegrees: 180
      spiralPasses: 1
      salvo: 3
      salvoSpread: 0.45
      salvoStagger: 0.08
      restAfter: 5
    - label: the right knight, top quarter, there and back
      shape: 8
      rightKnight: 1
      fromBelow: 0
      spacing: 0.4
      count: 4
      fanDegrees: 60
      weaveDegrees: 90
      spiralDegrees: 120
      spiralPasses: 2
      salvo: 3
      salvoSpread: 0.45
      salvoStagger: 0.08
      restAfter: 0.3
    - label: the left knight, top quarter, there and back
      shape: 8
      rightKnight: 0
      fromBelow: 0
      spacing: 0.4
      count: 4
      fanDegrees: 60
      weaveDegrees: 90
      spiralDegrees: 120
      spiralPasses: 2
      salvo: 3
      salvoSpread: 0.45
      salvoStagger: 0.08
      restAfter: 5
  - label: 'group 3: 5 fire ogres, over the top first'
    ogres:
      label: 5 fire ogres at once, 3 on top and 2 below
