<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="death-screen" class="death-overlay">
        <ui:VisualElement name="death-panel" class="death-panel">
            <ui:Label text="Left Knight died from Wolf" name="death-message" class="death-message" />
            <ui:VisualElement name="run-summary" class="run-summary">
                <ui:VisualElement name="gold-summary" class="summary-block">
                    <ui:Label text="GOLD THIS RUN" name="gold-caption" class="summary-caption" />
                    <ui:Label text="0" name="gold-amount" class="summary-amount" />
                </ui:VisualElement>
                <ui:VisualElement class="summary-divider" />
                <ui:VisualElement name="wave-summary" class="summary-block">
                    <ui:Label text="WAVE REACHED" name="wave-caption" class="summary-caption" />
                    <ui:Label text="1" name="wave-amount" class="summary-amount" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="death-actions" class="death-actions">
                <ui:Button text="Return to Camp" name="camp-button" class="death-button secondary" />
                <!-- Dev builds only: shown when the run came from Test Mode -->
                <ui:Button text="Try Wave Again" name="retry-wave-button" class="death-button secondary" style="display: none;" />
                <ui:Button text="Go Again" name="go-again-button" class="death-button primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>