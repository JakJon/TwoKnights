/* ============================================================
   Player HUD — glass vials. Thin pill bars: near-black track,
   hairline gold rim, vivid gradient fill (grayscale ramp tinted
   per bar) under a specular sheen. Text sits beside the vial,
   bright with a hard shadow so it reads over any field.
   ============================================================ */

.player-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 3% 2.2% 3%;
}

.knight-hud {
    flex-direction: column;
}

.hud-left { align-items: flex-start; }
.hud-right { align-items: flex-end; }

/* ---------- boss bar (top center, shown only while a boss lives) ---------- */

.boss-hud {
    position: absolute;
    top: 2.2%;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: center;
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.9s;
    transition-timing-function: ease-out;
}

/* added once the wave-name banner has faded out */
.boss-hud--visible { opacity: 1; }

.boss-title {
    font-size: 19px;
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    color: rgb(212, 162, 74);
    letter-spacing: 4px;
    margin-bottom: 3px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

/* The row owns the boss bar's width now that the HP number shares it — a percentage
   width on the bar itself would resolve against an auto-sized row and collapse. */
.boss-hud .bar-row {
    width: 34%;
    min-width: 380px;
    max-width: 640px;
    justify-content: center;
    margin-top: 0;
}

.boss-bar {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    height: 14px;
    border-radius: 7px;
}

/* gold to match the boss title, so the whole boss block reads as one unit */
.boss-hud .bar-side-label {
    margin-left: 8px;
    color: rgb(212, 162, 74);
}

/* deeper crimson than the knights' health red — reads as the enemy's blood */
.boss-health-fill { -unity-background-image-tint-color: rgb(214, 36, 52); }

/* ---------- streak / multiplier line ---------- */

/* "×N" on the left grows with the multiplier; "· STREAK n" never does.
   Bottom-aligned so a bigger number grows upward, away from the vials. */
.streak-line {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 1px;
}

/* one typeface for the whole line: the number only changes size and colour */
.streak-mult,
.streak-count {
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.streak-count {
    font-size: 13px;
    color: rgb(255, 244, 214);
    margin-left: 5px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

/* multiplier above x1 burns gold */
.streak-line.streak--hot .streak-count {
    color: rgb(255, 190, 46);
    text-shadow: 0 0 8px rgba(255, 190, 46, 0.65);
}

/* Holds the number and, behind it, the StreakFlames SpecialBar adds in code */
.streak-mult-box {
    flex-direction: row;
    align-items: flex-end;
}

/* black outline so every tier's number stands off its own flames. The THICK
   outline is TextRim's ring of black copies (SpecialBar sets its width per tier);
   this thin one only smooths the copies' edges. Each tier's glow below is drawn
   by the copy under that ring, never by the number itself. */
.streak-mult {
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
    transform-origin: center bottom;
    transition-property: scale;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-back;
}

/* x1: tiny white. On x3 and x4 a negative bottom margin cancels the taller
   descender space of the bigger size, so the number keeps the STREAK baseline. */
.streak-mult--1 {
    font-size: 10px;
    color: rgb(255, 255, 255);
}

/* x2: medium yellow, small fire */
.streak-mult--2 {
    font-size: 16px;
    color: rgb(255, 226, 64);
    text-shadow: 0 0 6px rgba(255, 200, 40, 0.7);
}

/* x3: large frost blue (the frost damage number's hue, deepened), medium fire */
.streak-mult--3 {
    font-size: 22px;
    color: rgb(64, 166, 242);
    margin-bottom: -2px;
    text-shadow: 0 0 8px rgba(64, 166, 242, 0.7);
}

/* x4: XL bright purple, blue-and-orange fire */
.streak-mult--4 {
    font-size: 30px;
    color: rgb(212, 104, 255);
    margin-bottom: -4px;
    text-shadow: 0 0 10px rgba(196, 80, 255, 0.85);
}

/* tier-up punch: snaps big instantly, then the base transition eases it home */
.streak-mult--pop {
    scale: 1.5 1.5;
    transition-duration: 0s;
}

/* ---------- vials ---------- */

.bar-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

/* labels sit toward screen center on both sides */
.hud-right .bar-row { flex-direction: row-reverse; }

.bar {
    width: 340px;
    height: 12px;
    background-color: rgb(10, 8, 6);
    border-width: 1px;
    border-color: rgba(123, 123, 123, 0.1);
    border-radius: 6px;
    overflow: hidden;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("BarFillGradient.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* glass highlight over fill and track alike */
.bar-sheen {
    position: absolute;
    left: 1px;
    top: 1px;
    right: 1px;
    bottom: 1px;
    border-radius: 5px;
    background-image: url("BarSheen.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.health-fill { -unity-background-image-tint-color: rgb(255, 64, 40); }

/* last quarter of health burns hotter */
.health-fill.health--low { -unity-background-image-tint-color: rgb(255, 32, 16); }

/* Low-health warning: a red halo behind the vial. The bar clips its children,
   so the halo sits beside it in a holder instead, drawn first so the vial
   covers its middle and only the rim glows. Hidden until PlayerHealth
   drives its opacity — see HealthBar.SetWarningGlow. The texture is 34x32
   with the pill's rounded ends in the outer 16px each side, so only the
   centre column stretches along the bar. */
.health-glow {
    position: absolute;
    left: -10px;
    right: -10px;
    top: -10px;
    bottom: -10px;
    background-image: url("HealthGlow.png");
    -unity-background-image-tint-color: rgb(255, 36, 20);
    -unity-slice-left: 16;
    -unity-slice-right: 16;
    opacity: 0;
}

.special-fill { -unity-background-image-tint-color: rgb(140, 92, 255); }

/* charged special shines bright */
.special-fill.special--full { -unity-background-image-tint-color: rgb(186, 148, 255); }

/* ---------- side labels ---------- */

.bar-side-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 244, 214);
    letter-spacing: 1px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
    min-width: 64px;
}

.hud-left .bar-side-label {
    margin-left: 8px;
    -unity-text-align: middle-left;
}

.hud-right .bar-side-label {
    margin-right: 8px;
    -unity-text-align: middle-right;
}

/* READY matches the charged vial and glows — it's off the vial, so it can shine */
.bar-side-label.bar-label--ready {
    color: rgb(200, 164, 255);
    text-shadow: 0 0 8px rgba(200, 164, 255, 0.7);
    letter-spacing: 2px;
}

/* ============================================================
   Venture curtain — the between-wave blackout. A sibling of
   .player-hud rather than a child, because .player-hud carries
   padding and absolute insets resolve against the padding box.
   Driven entirely by VentureCurtain.cs; the durations below are
   mirrored as constants there and the two must move together.
   ============================================================ */

.venture-curtain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    justify-content: center;
    align-items: center;
}

/* Solid backing. Carries the whole fade on ordinary wave gaps, and on
   ceremonial ones seals the hairlines between tiles once they've all landed. */
.venture-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.venture-fill--on { opacity: 1; }

/* the seal/unseal handoff, which happens while the screen is already black */
.venture-fill--instant { transition-duration: 0.06s; }

/* ---------- dither dissolve (ceremonial closes only) ---------- */

.venture-tiles {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    flex-direction: column;
}

.venture-tile-row {
    flex-grow: 1;
    flex-direction: row;
}

/* flex-grow rather than a percentage width: the row divides exactly, so the
   grid never leaves a rounding gap at the right edge */
.venture-tile {
    flex-grow: 1;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.venture-tile--on { opacity: 1; }

/* ---------- the venture line ---------- */

.venture-line {
    max-width: 62%;
    font-size: 26px;
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(212, 162, 74);
    letter-spacing: 2px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.95);
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out;
}

.venture-line--visible { opacity: 1; }
