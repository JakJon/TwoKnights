/* ============================================================
   Player HUD. The knights' health and special bars are pixel
   art painted in code (PixelBar.cs): slanted boxes with a black
   outline, on the same pixel grid as the sprites, and so is the
   boss's bar (2026-10-20). Text sits beside or above each bar,
   bright with a black outline so it reads over any field.
   ============================================================ */

.player-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 3% 2.2% 3%;
}

.knight-hud {
    flex-direction: column;
}

.hud-left { align-items: flex-start; }
.hud-right { align-items: flex-end; }

/* ---------- the run's pixel font ----------
   Everything the HUD prints during a run is set in Jersey 10 (owner,
   2026-10-13), the same file RunFont.cs builds the damage numbers and the
   text box from. Named on each text class, never on .player-hud, so the
   black copies TextRim makes of the streak number pick it up with the rest
   of that label's classes.

   Always "normal": the font has one weight and one slope, and asking for
   bold or italic makes UI Toolkit fake it by fattening or leaning the
   letters, which smears the pixels.

   Every size below is about a third bigger than the number it replaced.
   Jersey's capitals fill less of its em square than the old fonts' did, so
   that is what keeps the text the height it was. */
.boss-title,
.boss-health-amount,
.streak-mult,
.streak-count,
.bar-side-label,
.venture-line {
    -unity-font-definition: url("/Assets/Resources/Fonts/Jersey10-Regular.ttf");
    -unity-font-style: normal;
}

/* ---------- boss bar (bottom middle, shown only while a boss lives) ----------

   Bottom middle, between the two knights (owner, 2026-10-20: at the top it
   sat over the Overseer's own track), and drawn the way the knights' bars are
   (same day: "the same style as the knights"): a PixelBar in the health ramp,
   160 art pixels long where a knight's is 72 (BossHealthBar.BarPixels), and
   the boss's name and health in the run's pixel font with the streak count's
   black outline. The name and the number share one line above the bar, at the
   left and right ends of it, so the bar itself stays centred.

   The bar stands level with the knights' health bars: their blocks sit on the
   HUD's bottom padding with the special bar's row (15px, and 5.625px above
   it) under the health bar. The 26.4px is that padding, 2.2% of the panel's
   1200 width; a percentage written here would be taken from its height
   instead, which is not the same number. */

.boss-hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 47.025px;
    align-items: center;
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.9s;
    transition-timing-function: ease-out;
}

/* added once the wave-name banner has faded out */
.boss-hud--visible { opacity: 1; }

/* As wide as its widest child, the bar, so the line above stretches to the
   bar's two ends */
.boss-block {
    flex-direction: column;
    align-items: stretch;
}

/* The line stands close over the bar the way STREAK stands over a knight's
   health bar (see .streak-line) */
.boss-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: -8px;
}

/* Same size, spacing and outline as STREAK and the knights' numbers. The name
   keeps the boss's gold. Its left margin lines it up with the bar's top-left
   corner, which the slant puts 7 art pixels (13.125px) in from the end. */
.boss-title,
.boss-health-amount {
    font-size: 17px;
    letter-spacing: 3px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

.boss-title {
    color: rgb(212, 162, 74);
    margin-left: 13px;
    margin-right: 0;
    -unity-text-align: lower-left;
}

.boss-health-amount {
    color: rgb(255, 244, 214);
    margin-left: 0;
    margin-right: 0;
    -unity-text-align: lower-right;
}

/* ---------- streak / multiplier line ---------- */

/* "×N" on the left grows with the multiplier; "· STREAK n" never does.
   Bottom-aligned so a bigger number grows upward, away from the bars.

   The bottom margin stands the line close over the health bar. STREAK's
   letters sit 10.5px above the foot of the line: 2px of the theme's margin,
   4px of its padding and 4.5px the font leaves under its letters. The row
   below starts 5.625px further down. Taking 8px back leaves the letters
   about 8px above the bar, which is 13 screen pixels at 1080p. */
.streak-line {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: -8px;
}

/* one typeface for the whole line: the number only changes size and colour.
   The text is pinned to the foot of its label. A label is rounded up to a
   whole pixel taller than its text, and left at the top the text would ride
   that spare fraction up, by a different amount at each font size. */
.streak-mult,
.streak-count {
    letter-spacing: 3px;
    -unity-text-align: lower-left;
}

.streak-count {
    font-size: 17px;
    color: rgb(255, 244, 214);
    margin-left: 5px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

/* multiplier above x1 burns gold */
.streak-line.streak--hot .streak-count {
    color: rgb(255, 190, 46);
    text-shadow: 0 0 8px rgba(255, 190, 46, 0.65);
}

/* Holds the number and, behind it, the StreakFlames SpecialBar adds in code */
.streak-mult-box {
    flex-direction: row;
    align-items: flex-end;
}

/* black outline so every tier's number stands off its own flames. The THICK
   outline is TextRim's ring of black copies (SpecialBar sets its width per tier);
   this thin one only smooths the copies' edges. Each tier's glow below is drawn
   by the copy under that ring, never by the number itself. */
.streak-mult {
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
    transform-origin: center bottom;
    transition-property: scale;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-back;
}

/* x1: white, and the same size as x2 (owner, 2026-10-13: it was too small).

   Each tier's bottom margin stands the number on the same line as STREAK.
   The font leaves empty space under its letters, 0.27px for every pixel of
   font size, so a number bigger than STREAK's 17 has to sit lower by 0.27px
   for each pixel it is bigger: 1px at 21, 3px at 29, 6px at 39.

   Those drops are taken off 2px, not off 0. Unity's theme gives every Label
   a 2px bottom margin, STREAK's included, and a margin written here replaces
   that one instead of adding to it. Written as the bare drop, the number
   stood 2px under STREAK at every tier. */
.streak-mult--1 {
    font-size: 21px;
    color: rgb(255, 255, 255);
    margin-bottom: 1px;
}

/* x2: medium yellow, small fire */
.streak-mult--2 {
    font-size: 21px;
    color: rgb(255, 226, 64);
    margin-bottom: 1px;
    text-shadow: 0 0 6px rgba(255, 200, 40, 0.7);
}

/* x3: large frost blue (the frost damage number's hue, deepened), medium fire */
.streak-mult--3 {
    font-size: 29px;
    color: rgb(64, 166, 242);
    margin-bottom: -1px;
    text-shadow: 0 0 8px rgba(64, 166, 242, 0.7);
}

/* x4: XL bright purple, blue-and-orange fire */
.streak-mult--4 {
    font-size: 39px;
    color: rgb(212, 104, 255);
    margin-bottom: -4px;
    text-shadow: 0 0 10px rgba(196, 80, 255, 0.85);
}

/* tier-up punch: snaps big instantly, then the base transition eases it home */
.streak-mult--pop {
    scale: 1.5 1.5;
    transition-duration: 0s;
}

/* ---------- bars ---------- */

.bar-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

/* labels sit toward screen center on both sides */
.hud-right .bar-row { flex-direction: row-reverse; }

/* The knights' bars (owner, 2026-10-13). PixelBar.cs paints each one as a
   72 x 8 texture and hands it to this element as its background.

   One of the game's art pixels is 1.875px here: the panel is 1200 wide and
   the game's frame is 640 art pixels wide. So 135 x 15 is 72 x 8 art pixels,
   and at 1080p every art pixel lands on exactly 3 screen pixels. */
.pixel-bar {
    width: 135px;
    height: 15px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* A knight's row is exactly as tall as its bar, so the two bars can sit
   3 art pixels apart (5.625px). The number beside the bar is taller than
   that and hangs over the row above and below, which costs nothing: there
   is nothing else on the row. */
.knight-hud .bar-row {
    height: 15px;
    margin-top: 5.625px;
}

/* The halo behind a bar: red and pulsing with the chirp while a knight is
   low on health, and the special bar's own colour, pulsing slowly, while it
   is full (owner, 2026-10-13: he wanted the old bars' glow, not the outline
   flashing). It sits in a holder with the bar and is drawn first, so the bar
   covers its middle and only the rim glows. Hidden until HealthBar or
   SpecialBar drives its opacity.

   The texture is 34x32: a pill whose glow fades out over its outer 10
   pixels. It is cut into nine pieces so the fade keeps its own size however
   big the bar is, and drawn at three quarters size, so the fade is 7.5px
   and ends exactly where the element does: 7.5px out from the bar, which is
   4 art pixels. It was 10px out, and spread too far (owner, same day). */
.health-glow,
.special-glow {
    position: absolute;
    left: -7.5px;
    right: -7.5px;
    top: -7.5px;
    bottom: -7.5px;
    background-image: url("HealthGlow.png");
    -unity-slice-left: 16;
    -unity-slice-right: 16;
    -unity-slice-top: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 0.75px;
    opacity: 0;
}

.health-glow { -unity-background-image-tint-color: rgb(255, 36, 20); }

.special-glow { -unity-background-image-tint-color: rgb(120, 100, 255); }

/* ---------- side labels ---------- */

.bar-side-label {
    font-size: 14px;
    color: rgb(255, 244, 214);
    letter-spacing: 1px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
    min-width: 64px;
}

/* A knight's numbers tuck in beside the bar: about 2.5px clear of its
   outermost corner, counting the padding the theme gives every Label (1px on
   the left, 2px on the right). The slant opens that gap wider at the height
   of the digits. The top and bottom margins are zeroed because the theme's
   are uneven (4px over, 2px under) and would sit the number 1px low.

   Same size as STREAK, and outlined the same way: HealthBar and SpecialBar
   put a 1.5px TextRim round them, the one the streak count has (owner,
   2026-10-14: "slightly bigger and outlined"; they were 14px with only the
   shadow). The side margins grew by the outline's 1.5px with it, so the
   outline does not eat into the gap the number had from the bar.

   STREAK's letter spacing too (3px, was 1px), after he asked for the same
   weight as the streak text: packed tight, the outlines of neighbouring
   digits ran together into one black block and the numbers read heavier. */
.knight-hud .bar-side-label {
    font-size: 17px;
    letter-spacing: 3px;
    margin-top: 0;
    margin-bottom: 0;
}

.hud-left .bar-side-label {
    margin-left: 3px;
    -unity-text-align: middle-left;
}

.hud-right .bar-side-label {
    margin-right: 2px;
    -unity-text-align: middle-right;
}

/* READY is lilac and glows, like the halo behind the full bar. It keeps the
   numbers' 3px spacing; it had 2px of its own when they had 1px. */
.bar-side-label.bar-label--ready {
    color: rgb(200, 164, 255);
    text-shadow: 0 0 8px rgba(200, 164, 255, 0.7);
}

/* ============================================================
   Venture curtain — the between-wave blackout. A sibling of
   .player-hud rather than a child, because .player-hud carries
   padding and absolute insets resolve against the padding box.
   Driven entirely by VentureCurtain.cs; the durations below are
   mirrored as constants there and the two must move together.
   ============================================================ */

.venture-curtain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    justify-content: center;
    align-items: center;
}

/* Solid backing. Carries the whole fade on ordinary wave gaps, and on
   ceremonial ones seals the hairlines between tiles once they've all landed. */
.venture-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

.venture-fill--on { opacity: 1; }

/* the seal/unseal handoff, which happens while the screen is already black */
.venture-fill--instant { transition-duration: 0.06s; }

/* ---------- dither dissolve (ceremonial closes only) ---------- */

.venture-tiles {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    flex-direction: column;
}

.venture-tile-row {
    flex-grow: 1;
    flex-direction: row;
}

/* flex-grow rather than a percentage width: the row divides exactly, so the
   grid never leaves a rounding gap at the right edge */
.venture-tile {
    flex-grow: 1;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.venture-tile--on { opacity: 1; }

/* ---------- the venture line ---------- */

.venture-line {
    max-width: 62%;
    font-size: 32px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(212, 162, 74);
    letter-spacing: 2px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.95);
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out;
}

.venture-line--visible { opacity: 1; }
