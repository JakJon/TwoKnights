<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!-- Shared with the camp menu; QuestPanel/EquipmentPanel drive both -->
    <ui:Template name="QuestOverlay" src="QuestOverlay.uxml" />
    <ui:Template name="EquipmentOverlay" src="EquipmentOverlay.uxml" />
    <ui:VisualElement name="pause-menu" class="pause-menu-overlay">
        <!-- Landscape container: a knight's loadout down each side, the menu card
             in the middle. The container itself draws nothing — only the centre
             card is a card, so the loadout lists and their detail readouts sit
             directly on the scrim. -->
        <ui:VisualElement name="pause-panel" class="pause-panel">
            <ui:VisualElement name="loadout-left" class="loadout-column">
                <ui:Label text="LEFT KNIGHT'S UPGRADES" name="loadout-left-title" class="loadout-title knight--left" />
                <ui:ScrollView name="loadout-left-scroll" class="loadout-scroll">
                    <ui:VisualElement name="loadout-left-list" class="loadout-list" />
                </ui:ScrollView>
                <ui:Label text="▼" name="loadout-left-more" class="loadout-more" />
                <ui:VisualElement name="detail-left" class="loadout-detail">
                    <ui:Label name="detail-left-name" class="detail-name" />
                    <ui:Label name="detail-left-desc" class="detail-desc" />
                    <ui:VisualElement name="detail-left-stats" class="detail-stats" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="pause-card" class="pause-card">
                <ui:Label text="Paused" name="pause-title" class="pause-title" />
                <ui:Label text="WAVE I" name="pause-wave" class="pause-wave" />
                <ui:VisualElement name="pause-divider" class="pause-divider" />
                <ui:VisualElement name="pause-body" class="pause-body">
                    <ui:VisualElement name="main-actions" class="actions-container">
                        <ui:Button text="RESUME" name="resume-button" class="menu-button primary" />
                        <ui:Button text="QUESTS" name="pause-quests-button" class="menu-button" />
                        <ui:Button text="EQUIPMENT" name="pause-equipment-button" class="menu-button" />
                        <ui:Button text="QUIT" name="quit-button" class="menu-button secondary" />
                    </ui:VisualElement>
                    <ui:VisualElement name="confirm-actions" class="actions-container confirm" style="display: none;">
                        <ui:Label text="Abandon the run and return to camp?" name="confirm-text" class="confirm-text" />
                        <ui:VisualElement name="confirm-buttons" class="confirm-buttons">
                            <ui:Button text="YES" name="confirm-yes" class="menu-button danger" />
                            <ui:Button text="NO" name="confirm-no" class="menu-button primary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="loadout-right" class="loadout-column">
                <ui:Label text="RIGHT KNIGHT'S UPGRADES" name="loadout-right-title" class="loadout-title knight--right" />
                <ui:ScrollView name="loadout-right-scroll" class="loadout-scroll">
                    <ui:VisualElement name="loadout-right-list" class="loadout-list" />
                </ui:ScrollView>
                <ui:Label text="▼" name="loadout-right-more" class="loadout-more" />
                <ui:VisualElement name="detail-right" class="loadout-detail">
                    <ui:Label name="detail-right-name" class="detail-name" />
                    <ui:Label name="detail-right-desc" class="detail-desc" />
                    <ui:VisualElement name="detail-right-stats" class="detail-stats" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Sub-panels, drawn over the pause panel. CampMenu.uss is attached
             HERE rather than at the document root on purpose: it owns a
             .menu-button rule of its own, and at the root it would reach the
             pause buttons above and restyle them. Scoped to this subtree it
             only dresses the two overlays. -->
        <ui:VisualElement name="pause-overlays" class="pause-overlays">
            <ui:Style src="CampMenu.uss" />
            <ui:Instance template="QuestOverlay" class="overlay-host" />
            <ui:Instance template="EquipmentOverlay" class="overlay-host" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
