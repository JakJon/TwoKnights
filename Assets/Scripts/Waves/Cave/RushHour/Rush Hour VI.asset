  waveName: Rush Hour VI
  weight: 1000
  isUnlocked: 0
  waveDescription: Thirty ogres, half of them in big gangs.
  unlockedAfterXWaves: 20
  lockedAfterXWaves: 26
  useEnemyTracking: 1
  gangs:
  - label: in off both edges
    ogres:
      label: 4 ogres, in off both edges
      count: 4
      firstAt: 2
      interval: 1.2
      throwStagger: 0
      fireEveryNth: 0
      entries:
      - label: in off the left edge, high
        at: {x: -11.5, y: 1.5}
        mark: 1
      - label: in off the right edge, low
        at: {x: 11.5, y: -1.5}
        mark: 2
      - label: in off the left edge, low
        at: {x: -11.5, y: -2}
        mark: 1
      - label: in off the right edge, high
        at: {x: 11.5, y: 2}
        mark: 2
      startOnRight: 0
      entryX: 11
      entryY: -0.5
      laneStep: 1.1
    volleys:
    - label: fan round the left knight from above
      shape: 4
      rightKnight: 0
      fromBelow: 0
      spacing: 0.4
      count: 4
      fanDegrees: 75
      weaveDegrees: 90
      spiralDegrees: 180
      spiralPasses: 1
      salvo: 7
      salvoSpread: 0.45
      salvoStagger: 0.1
      restAfter: 2.75
    - label: spiral round the right knight from above
      shape: 8
      rightKnight: 1
      fromBelow: 0
      spacing: 0.4
      count: 5
      fanDegrees: 60
      weaveDegrees: 90
      spiralDegrees: 180
      spiralPasses: 2
      salvo: 5
      salvoSpread: 0.45
      salvoStagger: 0.1
      restAfter: 2.75
