<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- Wave Survived: two words floating over the cleared arena. No scrim, no
         panel, no button. Quest news is a scene with a person in it now — see
         QuestScene — so nothing else belongs here. -->
    <ui:VisualElement name="wave-survived-screen" class="ws-overlay">
        <ui:Label text="Wave Survived" name="ws-title" class="ws-title" />
    </ui:VisualElement>
</ui:UXML>
