/* ============================================================
   Gilded Vigil — warm near-black ground, one aged-gold accent.
   Surfaces separate by value (ground → panel → card → lifted),
   not by heavy outlines. Gold owns every interactive state.
   Same system as UpgradeMenu.uss.
   ============================================================ */

.camp-root {
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    background-color: rgb(22, 18, 12);
}

.layout-root {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: 2%;
}

.center-content {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 56%;
    min-width: 560px;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    padding: 2% 3%;
}

/* ---------- side status panels (frameless: value + one divider, no boxes) ---------- */

.status-panel {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    width: 21%;
    min-width: 240px;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    padding: 1.5%;
}

.status-panel.left { margin-right: 1%; }
.status-panel.right { margin-left: 1%; }

.status-title {
    align-self: stretch;
    -unity-text-align: upper-center;
    font-size: 20px;
    color: rgb(212, 162, 74);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    letter-spacing: 2px;
    padding-bottom: 7px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
}

.stat-line {
    align-self: stretch;
    -unity-text-align: upper-center;
    font-size: 14px;
    color: rgb(217, 207, 184);
    margin: 2px 0;
}

/* ---------- Crystal amounts (count, then icon — never the word) ----------
   Every price, balance and reward uses this pair so they read identically.
   Built and filled by CrystalText, which sets the row direction and the icon
   size inline so it also works inside UI documents that do not load this
   stylesheet. What is left here is colour and font only. */

.crystal-amount {
    justify-content: center;
}

.crystal-amount-count {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(212, 162, 74);
}

/* ---------- title ---------- */

.camp-title {
    font-size: 34px;
    color: rgb(236, 228, 211);
    -unity-text-align: middle-center;
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    letter-spacing: 4px;
}

.title-ornament {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    margin-bottom: 22px;
}

.ornament-rule {
    width: 64px;
    height: 1px;
    background-color: rgb(45, 38, 23);
}

.ornament-diamond {
    width: 7px;
    height: 7px;
    rotate: 45deg;
    border-radius: 1px;
    background-color: rgb(212, 162, 74);
    margin: 0 10px;
}

/* ---------- menu column (buttons follow the card anatomy) ---------- */

.menu-container {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: 420px;
    align-self: center;
}

.menu-button {
    width: 100%;
    /* Explicit height, not padding: the Quests button carries the notification
       dot as a child, and a Button with children measures differently from one
       with only text — it sat a few pixels taller than the rest of the menu. */
    height: 48px;
    margin: 5px 0;
    padding: 0 18px;
    background-color: rgb(33, 26, 16);
    border-width: 2px;
    border-radius: 4px;
    border-color: rgb(58, 50, 34);
    color: rgb(217, 207, 184);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color, translate, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* focused button slides right on a transform — no reflow, neighbors stay put */
.menu-button.menu-button--selected {
    background-color: rgb(42, 33, 19);
    border-color: rgb(212, 162, 74);
    color: rgb(242, 234, 217);
    translate: 8px 0;
}

/* primary action is solid gold, like the upgrade confirm button */
.menu-button.primary {
    background-color: rgb(212, 162, 74);
    border-color: rgb(212, 162, 74);
    color: rgb(36, 27, 13);
}

.menu-button.primary.menu-button--selected {
    background-color: rgb(240, 205, 120);
    border-color: rgb(255, 232, 170);
    color: rgb(36, 27, 13);
    translate: 0 0;
    scale: 1.04;
}

/* Shown but not yet open for business: the "???" shop. Dimmer than a secondary
   row and with no selected state of its own, because the cursor never lands on
   it — it is a placeholder telling the player there is a row here to earn. */
.menu-button.menu-button--locked {
    background-color: rgb(26, 21, 13);
    border-color: rgb(45, 38, 23);
    color: rgb(96, 88, 70);
}

/* quiet exit: recedes into the ground until focused */
.menu-button.secondary {
    background-color: transparent;
    border-color: rgb(45, 38, 23);
    color: rgb(141, 130, 102);
}

.menu-button.secondary.menu-button--selected {
    background-color: rgb(42, 33, 19);
    border-color: rgb(212, 162, 74);
    color: rgb(242, 234, 217);
}

/* danger keeps a muted ember identity; gold still takes over on focus */
.menu-button.danger {
    background-color: rgb(33, 26, 16);
    border-color: rgb(74, 40, 28);
    color: rgb(205, 133, 105);
}

.menu-button.danger.menu-button--selected {
    background-color: rgb(42, 33, 19);
    border-color: rgb(212, 162, 74);
    color: rgb(216, 148, 120);
}

/* first press arms the wipe; second press confirms */
.menu-button.danger.menu-button--armed,
.menu-button.danger.menu-button--armed.menu-button--selected {
    background-color: rgb(96, 32, 20);
    border-color: rgb(226, 120, 63);
    color: rgb(255, 235, 225);
}

/* ---------- overlay panels (quests / stats) ---------- */

/* Full screen. These are destinations, not dialogs — the quest log, the shop
   and the equipment screen each need the whole width for their own layout, and
   an inset card wasted a third of it on camp backdrop nobody was reading. */
/* Wrapper around an overlay instanced from its own UXML. The panel inside is
   absolutely positioned, so it fills its host — and a TemplateContainer left at
   its natural size is a zero-size box. Stretching the host to the screen makes
   the instanced panel land exactly where the inline markup used to.
   Ignore-picking so a hidden overlay's host never eats a click. */
.overlay-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    picking-mode: ignore;
}

.overlay-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(24, 19, 12);
    border-width: 0;
    border-radius: 0;
    padding: 26px 6% 20px 6%;
    flex-direction: column;
}

.overlay-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 10px;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
}

.overlay-title {
    font-size: 22px;
    color: rgb(212, 162, 74);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    letter-spacing: 2px;
}

.overlay-close-button {
    width: 34px;
    height: 34px;
    padding: 0;
    margin: 0;
    background-color: transparent;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(58, 50, 34);
    color: rgb(141, 130, 102);
    font-size: 14px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.overlay-close-button:hover,
.overlay-close-button:focus {
    background-color: rgb(42, 33, 19);
    border-color: rgb(212, 162, 74);
    color: rgb(212, 162, 74);
}

/* ---------- quest overlay body ---------- */

.quest-panel-body {
    flex-direction: row;
    flex-grow: 1;
}

/* the list is a well: it drops back to the ground value */
.quest-list {
    width: 34%;
    min-width: 220px;
    margin-right: 16px;
    background-color: rgb(22, 18, 12);
    border-width: 0;
    border-radius: 4px;
    padding: 4px;
}

.quest-list-item {
    margin: 0;
    padding: 12px 14px;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    border-left-width: 2px;
    border-left-color: transparent;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
    font-size: 14px;
    color: rgb(217, 207, 184);
    -unity-text-align: middle-left;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.quest-list-item:hover {
    background-color: rgb(33, 26, 16);
}

.quest-list-item--selected {
    background-color: rgb(42, 33, 19);
    border-left-color: rgb(212, 162, 74);
    color: rgb(242, 234, 217);
    -unity-font-style: bold;
}

.quest-list-item--completed {
    color: rgb(141, 130, 102);
    -unity-font-style: italic;
}

/* A quest the player has never put focus on. It carries a warm wash plus a gold
   band that sweeps across it — the band is a child element the panel animates,
   and overflow has to clip it or it runs off the side of the list.
   Both go away the moment the row is focused; see QuestPanel.ClearSheen. */
.quest-list-item--new {
    overflow: hidden;
    background-color: rgb(46, 35, 17);
    border-left-color: rgb(148, 112, 46);
    color: rgb(244, 231, 200);
}

.quest-list-item--new.quest-list-item--selected {
    background-color: rgb(56, 43, 22);
    border-left-color: rgb(212, 162, 74);
}

.quest-new-sheen {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 40%;
    opacity: 0;
}

.quest-list-item--completed.quest-list-item--selected {
    color: rgb(179, 168, 143);
}

.quest-details {
    flex-grow: 1;
    background-color: rgb(33, 26, 16);
    border-width: 0;
    border-radius: 4px;
    padding: 20px;
    flex-direction: column;
}

.quest-detail-name {
    font-size: 22px;
    color: rgb(242, 234, 217);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    margin-bottom: 10px;
    white-space: normal;
}

.quest-detail-description {
    font-size: 14px;
    color: rgb(179, 168, 143);
    white-space: normal;
    flex-grow: 1;
    margin-bottom: 10px;
}

.quest-detail-progress {
    font-size: 13px;
    color: rgb(217, 207, 184);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.quest-detail-reward {
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.quest-detail-reward--active {
    color: rgb(212, 162, 74);
}

.quest-detail-reward--completed {
    color: rgb(240, 205, 120);
}

/* ---------- level select ----------
   The maps as a stack of cards. The one in focus is held up in the middle at
   full size and full colour; the rest are tucked in behind it to either side —
   narrower, shorter, dulled, and with a shadow falling on them from whatever
   sits on top. Every slot's width, height and offset is written inline by
   MapSelectPanel; what is here is everything that does not depend on how deep
   in the stack a card happens to be. */

/* Edge to edge, unlike the inset overlays around it. Picking where the run
   happens is the last thing the camp asks, and the cards ARE the screen at that
   point — there is no title and nothing behind worth leaving a frame of. */
.map-select-panel {
    padding: 20px 4% 24px 4%;
}

/* Nothing left in the header but the close button, so it sits on the right on
   its own and the rule under it goes: a divider under an empty row is a line
   drawn around nothing, and the cards want the height. */
.map-select-header {
    justify-content: flex-end;
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom-width: 0;
}

/* Only a coordinate space: every slot inside is positioned absolutely. The top
   margin is headroom for the stars, which hang off the focused card's upper
   edge rather than taking a row inside it. */
.map-card-stage {
    flex-grow: 1;
    margin-top: 46px;
    margin-bottom: 8px;
}

/* Pinned to the middle of the stage and full height. The panel walks each slot
   out to its place with a margin-left of (offset − half its own width), so
   changing a card's width never drags its centre off the line. */
.map-card-slot {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    justify-content: center;
    transition-property: width, margin-left, opacity;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

/* The card's actual rectangle within that full-height slot, centred in it. It
   exists so the shadows have something card-shaped to bleed out from — inset
   against the slot they would stretch the whole height of the screen. */
.map-card-body {
    width: 100%;
    transition-property: height;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

/* ---------- the drop shadow ----------
   UI Toolkit has no box-shadow, so it is two dark rings bled out from under the
   card: a wide faint one and a tight dark one, which together read as falloff.
   One ring alone reads as a second card behind the first. */
.map-card-shadow {
    position: absolute;
    border-radius: 14px;
}

.map-card-shadow--outer {
    left: -15px;
    right: -15px;
    top: -8px;
    bottom: -19px;
    background-color: rgba(0, 0, 0, 0.22);
}

.map-card-shadow--inner {
    left: -6px;
    right: -6px;
    top: -3px;
    bottom: -9px;
    background-color: rgba(0, 0, 0, 0.45);
}

.map-card {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    height: 100%;
    padding: 14px 16px 16px 16px;
    background-color: rgb(34, 27, 17);
    border-width: 2px;
    border-radius: 10px;
    border-color: rgb(66, 56, 38);
    transition-property: background-color, border-color;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.map-card--focused {
    background-color: rgb(46, 36, 21);
    border-color: rgb(212, 162, 74);
}

/* ---------- the three stars ----------
   Straddling the top edge, drawn by Painter2D rather than typed. Only the card
   in focus wears them: a card behind is cropped by its neighbour, and a row of
   stars half-hidden under another card is worse than no row at all. */
/* Anchored by its BOTTOM edge rather than sized by its contents: the row is a
   fixed 40px ending 6px below the card's top, and the stars hang up out of it
   from there. A taller star then rises higher on its own, which is what makes
   the middle one read as a crest without any extra offset. */
.map-card-stars {
    position: absolute;
    top: -34px;
    left: 0;
    right: 0;
    height: 40px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.map-star {
    width: 34px;
    height: 34px;
    margin-left: -3px;
    margin-right: -3px;
}

/* the middle star rides higher and larger, the way a crest does */
.map-star--crown {
    width: 46px;
    height: 46px;
}

.map-card-title {
    -unity-text-align: middle-center;
    font-size: 21px;
    color: rgb(242, 234, 217);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    letter-spacing: 1px;
    white-space: normal;
    margin-bottom: 10px;
}

/* the artwork well: recessed, and it owns most of the card's height */
.map-card-art {
    flex-grow: 1;
    min-height: 80px;
    border-radius: 6px;
    background-color: rgb(22, 18, 12);
    -unity-background-scale-mode: scale-and-crop;
}

/* The line under the picture, off the concept art. It separates what the map IS
   — its name and its face — from what the save has to say about it. */
.map-card-rule {
    height: 1px;
    margin-top: 12px;
    margin-bottom: 10px;
    background-color: rgb(96, 80, 50);
}

.map-card-detail {
    flex-direction: column;
    flex-grow: 1;
}

.map-card-description {
    font-size: 13px;
    color: rgb(196, 183, 155);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* pushes the two counters down to the bottom of the card, wherever the
   description happens to stop */
.map-card-spacer {
    flex-grow: 1;
    min-height: 14px;
}

.map-card-stat {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
}

.map-card-stat-label {
    font-size: 12px;
    color: rgb(150, 138, 110);
    white-space: normal;
    flex-shrink: 1;
}

.map-card-stat-value {
    font-size: 15px;
    color: rgb(226, 190, 112);
    -unity-font-style: bold;
    margin-left: 10px;
    flex-shrink: 0;
}

/* ---------- locked maps ----------
   Obscured, not hidden: the card keeps its shape and keeps its picture, so the
   campaign's length stays legible, but the name is withheld and everything the
   save would have said about the place is simply absent. UI Toolkit has no
   greyscale filter, so "greyed out" is a flat grey background tint — which
   multiplies the artwork's colour down toward stone — plus the scrim over it.
   The tint is deliberate in place of opacity: opacity cascades to children and
   would fade the padlock along with the thing it is covering. */
.map-card--locked .map-card-art {
    -unity-background-image-tint-color: rgb(58, 56, 52);
}

.map-card--locked {
    background-color: rgb(24, 21, 18);
    border-color: rgb(50, 47, 42);
}

/* even in focus a locked card never lights gold — that colour means "go" */
.map-card--locked.map-card--focused {
    background-color: rgb(31, 28, 24);
    border-color: rgb(110, 104, 92);
}

.map-card--locked .map-card-title {
    color: rgb(132, 123, 98);
    letter-spacing: 5px;
}

.map-card--locked .map-card-rule {
    background-color: rgb(58, 55, 48);
}

.map-card-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 9, 7, 0.5);
    border-radius: 6px;
}

/* A padlock built from two boxes. Same reasoning as the star being drawn: the
   camp UI has no icon atlas, and a glyph would depend on the serif font
   happening to ship one. */
.map-lock {
    align-items: center;
    justify-content: center;
}

/* the shackle: a bottomless box with a rounded top reads as the arch */
.map-lock-shackle {
    width: 20px;
    height: 13px;
    border-width: 3px;
    border-bottom-width: 0;
    border-color: rgb(150, 140, 116);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

.map-lock-body {
    width: 30px;
    height: 23px;
    border-radius: 3px;
    background-color: rgb(150, 140, 116);
}

/* ---------- file select (three horizontal bars, one per save file) ----------
   Bars, not panes: a save file is a row of facts (name, what it has finished,
   time, crystals) and a wide row lets those sit on one baseline instead of
   stacking. The map panes opposite this are tall because a map is an image; a
   file is a record.
   Selection reads off the same gold as everywhere else, plus a thicker lit left
   edge — a bar this wide cannot use the panes' scale-up without clipping. */

.file-select-panel {
    padding: 26px 8% 20px 8%;
}

.file-slot-column {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    padding: 6px 0;
}

.file-slot {
    flex-direction: row;
    align-items: center;
    margin: 7px 0;
    padding: 14px 18px;
    background-color: rgb(28, 22, 14);
    border-width: 2px;
    border-left-width: 4px;
    border-radius: 5px;
    border-color: rgb(58, 50, 34);
    transition-property: background-color, border-color, opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    opacity: 0.72;
}

.file-slot--selected {
    background-color: rgb(42, 33, 19);
    border-color: rgb(212, 162, 74);
    border-left-color: rgb(240, 205, 120);
    opacity: 1;
}

.file-slot--empty {
    background-color: rgb(24, 19, 12);
}

/* Roman numeral: the slot's identity, kept apart from the file's own name so a
   file called "File 2" sitting in slot 3 is still unambiguous. */
.file-slot-index {
    width: 46px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(122, 112, 88);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    letter-spacing: 2px;
}

.file-slot--selected .file-slot-index {
    color: rgb(212, 162, 74);
}

.file-slot-main {
    flex-direction: column;
    flex-grow: 1;
    padding-left: 16px;
    border-left-width: 1px;
    border-left-color: rgb(45, 38, 23);
}

.file-slot-name {
    font-size: 20px;
    color: rgb(217, 207, 184);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    letter-spacing: 2px;
}

.file-slot--selected .file-slot-name {
    color: rgb(242, 234, 217);
}

.file-slot--empty .file-slot-name {
    color: rgb(141, 130, 102);
}

.file-slot-sub {
    font-size: 12px;
    color: rgb(141, 130, 102);
    margin-top: 4px;
}

/* Marks: the second line under a file's name, standing where the wave number and
   map name used to be written out. Circles for finished maps, squares for slots
   won past the starting ones — unlabelled on purpose, so the row is something the
   player comes to read rather than something the screen explains. Sized to the
   line they replaced, so a bar keeps the same height whichever it carries. */

.file-slot-marks {
    flex-direction: row;
    align-items: center;
    height: 16px;
    margin-top: 4px;
}

.file-slot-mark-group {
    flex-direction: row;
    align-items: center;
}

.file-slot-mark {
    width: 11px;
    height: 11px;
    margin-right: 7px;
    /* Slightly darker than the fill so a mark still has an edge against the lit
       bar behind a selected file */
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.35);
}

.file-slot-mark-circle {
    border-radius: 6px;
}

.file-slot-mark-square {
    width: 10px;
    height: 10px;
    border-radius: 1px;
}

/* Only drawn when there are marks of both kinds — see FileSelectPanel.BuildMarks */
.file-slot-mark-divider {
    width: 1px;
    height: 12px;
    margin-right: 10px;
    margin-left: 3px;
    background-color: rgb(58, 50, 34);
}

.file-slot-stats {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.file-slot-stat {
    flex-direction: column;
    align-items: center;
    min-width: 108px;
    margin-left: 16px;
}

.file-slot-stat-value {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(212, 162, 74);
}

/* Crystal totals come from CrystalText, so match its count to the value beside it */
.file-slot-stat .crystal-amount-count {
    font-size: 16px;
}

.file-slot-stat-caption {
    font-size: 10px;
    color: rgb(122, 112, 88);
    letter-spacing: 1px;
    margin-top: 4px;
}

.map-empty-line {
    font-size: 14px;
    color: rgb(141, 130, 102);
    -unity-text-align: middle-center;
    flex-grow: 1;
}

/* ---------- test mode (dev builds only) ---------- */

/* the test overlay owns the whole screen — the upgrade list is long */
#test-panel {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 0;
}

/* dev button keeps a cooler, utilitarian identity so it reads as a tool */
.menu-button.test {
    border-color: rgb(38, 52, 58);
    color: rgb(122, 160, 170);
}

.menu-button.test.menu-button--selected {
    background-color: rgb(30, 38, 40);
    border-color: rgb(122, 160, 170);
    color: rgb(196, 222, 228);
}

.test-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 14px;
    border-radius: 3px;
    border-left-width: 2px;
    border-left-color: transparent;
}

/* The wave and map rows are the panel's fixed chrome, sitting above the
   scrolling list. Without flex-shrink: 0 the tall list squeezes them until
   their labels spill over each other; they also carry more weight than a
   single upgrade row, so they get more room than one. */
#test-wave-row,
#test-map-row {
    flex-shrink: 0;
    padding: 8px 16px;
    margin-bottom: 4px;
}

.test-row--selected {
    background-color: rgb(42, 33, 19);
    border-left-color: rgb(212, 162, 74);
}

.test-row-name {
    font-size: 14px;
    color: rgb(217, 207, 184);
}

.test-row--selected .test-row-name {
    color: rgb(242, 234, 217);
    -unity-font-style: bold;
}

.test-row-value {
    font-size: 14px;
    color: rgb(212, 162, 74);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.test-budget-line {
    font-size: 13px;
    color: rgb(179, 168, 143);
    -unity-text-align: middle-center;
    margin: 6px 0;
    letter-spacing: 1px;
}

.test-budget-line--over {
    color: rgb(216, 110, 80);
    -unity-font-style: bold;
}

.test-upgrade-list {
    flex-grow: 1;
    background-color: rgb(22, 18, 12);
    border-width: 0;
    border-radius: 4px;
    padding: 4px;
}

/* Order category banner above each group of chain sections */
.test-category-header {
    font-size: 14px;
    color: rgb(212, 162, 74);
    letter-spacing: 3px;
    -unity-font-style: bold;
    padding: 16px 14px 4px 8px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 162, 74);
    margin-bottom: 2px;
}

/* section headers are selectable rows that expand/collapse their chain */
.test-section-header {
    font-size: 12px;
    color: rgb(141, 130, 102);
    letter-spacing: 2px;
    -unity-font-style: bold;
    padding: 10px 14px 8px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
    border-left-width: 2px;
    border-left-color: transparent;
}

.test-section-header.test-row--selected {
    background-color: rgb(42, 33, 19);
    border-left-color: rgb(212, 162, 74);
    color: rgb(240, 205, 120);
}

/* per-knight toggle chips on each upgrade row */
.test-toggle {
    width: 34px;
    padding: 3px 0;
    margin-left: 8px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(58, 50, 34);
    background-color: transparent;
    color: rgb(141, 130, 102);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.test-toggle--on {
    background-color: rgb(212, 162, 74);
    border-color: rgb(212, 162, 74);
    color: rgb(36, 27, 13);
}

.test-start-row {
    flex-shrink: 0; /* chrome, like the wave/map rows — the list gives up the space */
    margin-top: 8px;
    padding: 11px 14px;
    background-color: rgb(33, 26, 16);
    border-width: 2px;
    border-radius: 4px;
    border-color: rgb(58, 50, 34);
    justify-content: center;
}

.test-start-row.test-row--selected {
    background-color: rgb(212, 162, 74);
    border-color: rgb(212, 162, 74);
}

.test-start-row.test-start-row--blocked {
    border-color: rgb(74, 40, 28);
}

.test-start-label {
    font-size: 15px;
    color: rgb(217, 207, 184);
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.test-start-row.test-row--selected .test-start-label {
    color: rgb(36, 27, 13);
}

.test-start-row.test-start-row--blocked .test-start-label {
    color: rgb(205, 133, 105);
}

/* ---------- stats overlay body ---------- */

.stats-list {
    flex-grow: 1;
    background-color: rgb(22, 18, 12);
    border-width: 0;
    border-radius: 4px;
    padding: 4px;
}

.stats-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
}

.stats-label {
    font-size: 14px;
    color: rgb(217, 207, 184);
}

.stats-value {
    font-size: 14px;
    color: rgb(212, 162, 74);
    -unity-font-style: bold;
}

/* Unread marker on a menu entry. Absolute so it rides the button's corner
   without disturbing the centred label the rest of the menu depends on. */
.menu-badge {
    position: absolute;
    top: 15px;
    right: 14px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: rgb(255, 205, 120);
    border-width: 0;
}

/* The halo sits behind the dot and is what actually reads as a glow: it scales
   and fades on the same beat, so the dot looks like it is breathing light
   rather than just blinking. */
.menu-badge-glow {
    position: absolute;
    top: 9px;
    right: 8px;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: rgba(255, 190, 90, 0.35);
    border-width: 0;
}

/* Collapsible map header in the quest log. Reads as a divider, not a quest —
   dimmer, wider tracking, and it keeps its own left rule. */
.quest-group-header {
    margin: 0;
    padding: 10px 12px;
    background-color: rgb(28, 23, 14);
    border-width: 0;
    border-radius: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 50, 34);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(168, 152, 112);
    -unity-text-align: middle-left;
    transition-property: background-color, color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}
.quest-group-header:hover {
    color: rgb(212, 162, 74);
}
.quest-group-header.quest-list-item--selected {
    background-color: rgb(40, 33, 20);
    color: rgb(240, 205, 120);
}

/* The Completed shelf at the foot of a map group. Indented and dimmer than the
   map header above it so it reads as a shelf inside that map rather than as a
   fourth map, and quiet enough that the live quests stay the loudest thing in
   the list. */
.quest-group-header--completed {
    padding-left: 26px;
    background-color: rgb(24, 20, 12);
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(132, 120, 94);
}

/* A shelf holding a quest the player has never opened. Two classes so it beats
   the plain shelf rule above, which would otherwise take the warm wash back off
   and leave the sweeping band with nothing behind it. */
.quest-group-header--completed.quest-list-item--new {
    background-color: rgb(40, 31, 15);
    color: rgb(206, 186, 140);
}

/* ---------- Equipment ---------- */

.equipment-body {
    flex-direction: row;
    justify-content: center;
    margin: 10px 0 6px 0;
}

.equip-column {
    width: 46%;
    margin: 0 2%;
}

.equip-column-title {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(168, 152, 112);
    -unity-text-align: middle-center;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 50, 34);
    margin-bottom: 8px;
}

.equip-slot {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 11px 14px;
    margin-bottom: 6px;
    background-color: rgb(28, 23, 14);
    border-width: 2px;
    border-color: rgb(45, 38, 23);
    border-radius: 4px;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}
.equip-slot--selected {
    background-color: rgb(45, 37, 22);
    border-color: rgb(212, 162, 74);
}

/* A special is not a piece of kit, and at two slots each the column was four
   identical rows. The violet ground separates the two groups by HUE, leaving
   gold to mean only "this is the row you are on" — the same division the rest
   of the menu runs on. */
.equip-slot--special {
    background-color: rgb(31, 25, 40);
    border-color: rgb(54, 44, 70);
}
.equip-slot--special.equip-slot--selected {
    background-color: rgb(48, 38, 64);
    border-color: rgb(212, 162, 74);
}
.equip-slot-kind {
    font-size: 10px;
    letter-spacing: 2px;
    color: rgb(130, 118, 90);
}
.equip-slot--special .equip-slot-kind {
    color: rgb(152, 134, 180);
}
.equip-slot-value {
    font-size: 14px;
    color: rgb(217, 207, 184);
    -unity-font-style: bold;
}
.equip-slot--empty .equip-slot-value {
    color: rgb(112, 102, 80);
    -unity-font-style: italic;
}

/* The picker sits over the columns rather than beside them — at two slots a
   knight there is not room for both, and the choice deserves the full width */
.equipment-picker {
    max-height: 210px;
    margin: 0 8% 6px 8%;
    background-color: rgb(22, 18, 12);
    border-width: 2px;
    border-color: rgb(58, 50, 34);
    border-radius: 4px;
}
.equip-pick {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
    border-left-width: 2px;
    border-left-color: transparent;
}
.equip-pick--selected {
    background-color: rgb(45, 37, 22);
    border-left-color: rgb(212, 162, 74);
}
.equip-pick-name {
    font-size: 14px;
    color: rgb(217, 207, 184);
}
.equip-pick-note {
    font-size: 11px;
    -unity-font-style: italic;
    color: rgb(150, 120, 70);
}

.equipment-detail {
    min-height: 40px;
    padding: 6px 10% 0 10%;
    font-size: 14px;
    color: rgb(224, 214, 192);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Shop ---------- */

.shop-crystals {
    margin: 6px 0 10px 0;
}

/* The shop header states the balance larger than an inline price does */
.shop-crystals .crystal-amount-count {
    font-size: 16px;
}

.shop-list {
    max-height: 260px;
    margin: 0 8%;
    border-width: 1px;
    border-color: rgb(45, 38, 23);
    border-radius: 4px;
}

.shop-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 11px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
    border-left-width: 2px;
    border-left-color: transparent;
}
.shop-row--selected {
    background-color: rgb(45, 37, 22);
    border-left-color: rgb(212, 162, 74);
}
.shop-row-name {
    font-size: 14px;
    color: rgb(217, 207, 184);
}
/* The price is a crystal-amount row for anything on sale, and a plain word for
   anything already owned — so the colour rules below target both the label and
   the count inside the row. */
.shop-row-price {
    flex-shrink: 0;
}

.shop-row-owned-label,
.shop-row-price .crystal-amount-count {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(212, 162, 74);
}

/* Owned and unaffordable read differently: one is done, the other is a wall */
.shop-row--owned .shop-row-name { color: rgb(141, 130, 102); -unity-font-style: italic; }
.shop-row--owned .shop-row-owned-label { color: rgb(120, 140, 110); }
.shop-row--unaffordable .shop-row-name { color: rgb(128, 118, 98); }
.shop-row--unaffordable .shop-row-price .crystal-amount-count { color: rgb(140, 92, 74); }


/* ---------- Scrollbars (Gilded Vigil) ---------- */

/* The scroller is a sibling of the content viewport INSIDE the ScrollView, so
   it has to be sized and inset here — styling only the dragger left it floating
   past the list's border and running below its bottom edge. */
.unity-scroll-view__vertical-scroller {
    width: 12px;
    min-width: 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 3px 3px 3px 2px;
}
.unity-scroll-view__horizontal-scroller {
    display: none;
}

.unity-scroller {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 0;
}

/* The arrow buttons are chrome from another era, and they steal height from the
   track — the list is driven by a stick or a wheel */
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

/* The slider must fill the scroller once the buttons are gone, or the track
   keeps their reserved space and the dragger sits offset */
.unity-scroller__slider {
    width: 12px;
    min-width: 12px;
    margin: 0;
    top: 0;
    bottom: 0;
}

.unity-base-slider--vertical {
    width: 12px;
    min-width: 12px;
    margin: 0;
}

.unity-base-slider--vertical > .unity-base-slider__input {
    width: 12px;
    min-width: 12px;
}

.unity-base-slider--vertical .unity-base-slider__tracker {
    background-color: rgb(30, 25, 16);
    border-width: 1px;
    border-color: rgb(48, 40, 25);
    border-radius: 6px;
    margin: 0;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.unity-base-slider--vertical .unity-base-slider__dragger {
    background-color: rgb(138, 106, 50);
    border-width: 0;
    border-radius: 4px;
    width: 8px;
    min-width: 8px;
    left: 2px;
    margin: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}
.unity-base-slider--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(212, 162, 74);
}

/* Border-box drag area, otherwise UI Toolkit gives the dragger a hit region
   wider than the visible bar and it looks misaligned against the track */
.unity-base-slider__dragger-border {
    display: none;
}

/* A controller can step to a reward square, so it needs a selected look of its
   own — :hover only ever fires for a mouse */
.reward-square--selected {
    border-color: rgb(212, 162, 74);
    background-color: rgb(38, 31, 19);
    scale: 1.08 1.08;
}


/* ---------- Reward squares + hover tip ---------- */

.quest-reward-icons {
    flex-direction: row;
    margin-top: 10px;
}

/* The square is the whole message — no label under it. What it is comes from
   the hover tip, which keeps a row of three rewards from turning into prose. */
.reward-square {
    width: 52px;
    height: 52px;
    margin-right: 10px;
    background-color: rgb(22, 18, 12);
    border-width: 2px;
    border-color: rgb(58, 50, 34);
    border-radius: 4px;
    /* row, so a crystal count sits beside its icon rather than under it */
    flex-direction: row;
    justify-content: center;
    align-items: center;
    transition-property: border-color, background-color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.reward-square:hover {
    border-color: rgb(212, 162, 74);
    background-color: rgb(38, 31, 19);
    scale: 1.08 1.08;
}
.reward-square-image {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
}
/* Count sits inline to the left of the icon, matching every other crystal amount */
.reward-square-count {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 215, 130);
    margin-right: 3px;
}

.reward-tip {
    position: absolute;
    padding: 6px 10px;
    background-color: rgb(16, 13, 8);
    border-width: 1px;
    border-color: rgb(212, 162, 74);
    border-radius: 3px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(240, 205, 120);
    white-space: nowrap;
}

/* ---------- Item art in the shop and equipment rows ---------- */

/* 32px matches the source art 1:1. At 28 the icons landed on a 0.875 downscale,
   which drops whole rows of pixels and mangles the outlines. */
.row-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.shop-row-left,
.equip-slot-left,
.equip-pick-left {
    flex-direction: row;
    align-items: center;
}

/* ---------- Shop tabs ---------- */

.shop-tabs {
    flex-direction: row;
    justify-content: center;
    margin: 0 8% 10px 8%;
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 40, 25);
}

.shop-tab {
    padding: 8px 26px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(122, 112, 90);
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    transition-property: color, border-bottom-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}
.shop-tab:hover {
    color: rgb(190, 172, 132);
}
.shop-tab--active {
    color: rgb(240, 205, 120);
    border-bottom-color: rgb(212, 162, 74);
}

/* ============================================================
   Quest log — the NPC portrait and the Order subheadings.

   The portrait sits INSIDE the heading row beside the quest's name
   rather than above the body text, so a face and a title read as one
   heading instead of as two stacked things. 48px: big enough for a
   32x32 sprite to read at 1.5x without landing on a fractional scale.
   ============================================================ */

.quest-detail-heading {
    flex-direction: row;
    align-items: center;
}

.quest-detail-npc {
    width: 48px;
    height: 48px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* "Order of the Serpent" under the assassin. Quiet on purpose — it is a
   label for the rows beneath it, not a row in its own right, and it is
   deliberately not focusable so the stick never appears to stick on it. */
.quest-subgroup {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(138, 127, 104);
    margin: 8px 0 2px 14px;
}

/* ---------- settings ----------
   Two mix rows sharing the overlay chrome above. Focus is the same aged gold
   every other interactive state in the Gilded Vigil palette uses, carried on the
   row rather than on the bar so the label, the track and the percentage all move
   together — a focused bar alone reads as "this one is loud", not "this one is
   selected". */
.settings-body {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
    padding-top: 18px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    padding: 12px 14px;
    margin-bottom: 10px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(45, 38, 23);
    background-color: rgb(28, 23, 15);
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.settings-row--focused {
    background-color: rgb(42, 33, 19);
    border-color: rgb(212, 162, 74);
}

.settings-row-label {
    width: 130px;
    font-size: 18px;
    color: rgb(141, 130, 102);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    letter-spacing: 1px;
}

.settings-row--focused .settings-row-label {
    color: rgb(212, 162, 74);
}

/* The track. overflow:hidden keeps the fill inside the rounded ends at 100%. */
.settings-bar {
    flex-grow: 1;
    height: 14px;
    border-width: 1px;
    border-radius: 3px;
    border-color: rgb(58, 50, 34);
    background-color: rgb(18, 14, 9);
    overflow: hidden;
}

.settings-bar-fill {
    height: 100%;
    width: 50%;
    background-color: rgb(110, 90, 48);
}

.settings-row--focused .settings-bar-fill {
    background-color: rgb(212, 162, 74);
}

/* Fixed width so the bar does not twitch sideways as the number crosses 10% and
   100% — the percentage is right-aligned into a column that never resizes. */
.settings-row-value {
    width: 62px;
    -unity-text-align: middle-right;
    font-size: 16px;
    color: rgb(141, 130, 102);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
}

.settings-row--focused .settings-row-value {
    color: rgb(212, 162, 74);
}

.settings-hint {
    -unity-text-align: middle-center;
    font-size: 13px;
    color: rgb(101, 92, 72);
    padding-top: 6px;
    letter-spacing: 1px;
}
