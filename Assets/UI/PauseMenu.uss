/* ============================================================
   Pause menu — Gilded Vigil. Warm near-black scrim, one card
   panel separated by value, aged gold owning every interactive
   state (focus = gold rim, active = brighter gold).
   ============================================================ */

.pause-menu-overlay {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    background-color: rgba(12, 9, 5, 0.8);
}

.pause-panel {
    flex-direction: column;
    align-items: stretch;
    width: 34%;
    min-width: 420px;
    max-width: 800px;
    padding: 30px 36px 34px 36px;
    border-radius: 6px;
    background-color: rgb(33, 26, 16);
    border-width: 1px;
    border-color: rgb(58, 50, 34);
}

.pause-title {
    font-size: 36px;
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    color: rgb(236, 228, 211);
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.pause-wave {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(212, 162, 74);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.pause-divider {
    height: 1px;
    background-color: rgb(58, 50, 34);
    margin: 0 8px 18px 8px;
}

/* ---- Loadout: each knight's owned upgrades, one row per chain ---- */

.pause-loadout {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
}

.loadout-column {
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    flex-basis: 0;
}

.loadout-divider {
    width: 1px;
    background-color: rgb(58, 50, 34);
    margin: 2px 18px;
}

.loadout-title {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(212, 162, 74);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.loadout-list {
    flex-direction: column;
    align-items: stretch;
}

/* one owned upgrade — a left color-rail keyed to its Order, like the draft cards */
.loadout-chip {
    font-size: 12px;
    color: rgb(217, 207, 184);
    -unity-text-align: middle-left;
    white-space: normal;
    padding: 3px 8px;
    margin: 2px 0;
    border-radius: 3px;
    background-color: rgb(42, 34, 21);
    border-left-width: 3px;
    border-left-color: rgb(58, 50, 34);
}

.loadout-chip.order--serpent { border-left-color: rgb(126, 179, 91); }
.loadout-chip.order--shadow { border-left-color: rgb(129, 128, 214); }
.loadout-chip.order--ember { border-left-color: rgb(226, 120, 63); }
.loadout-chip.order--bulwark { border-left-color: rgb(158, 168, 178); }
.loadout-chip.order--dawn { border-left-color: rgb(240, 200, 170); }

/* placeholder when a knight has taken nothing yet */
.loadout-empty {
    font-size: 12px;
    color: rgb(120, 110, 90);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    padding: 6px 0;
}

.pause-body {
    flex-direction: column;
    align-items: stretch;
}

.actions-container {
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.menu-button {
    width: 82%;
    min-width: 240px;
    height: 46px;
    margin: 7px 0;
    border-radius: 4px;
    border-width: 1px;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(217, 207, 184);
    background-color: rgb(42, 34, 21);
    border-color: rgb(58, 50, 34);
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.12s;
}

/* gold owns focus (gamepad) and hover alike */
.menu-button:hover,
.menu-button:focus {
    background-color: rgb(51, 40, 21);
    border-color: rgb(212, 162, 74);
    color: rgb(255, 248, 230);
    scale: 1.03;
}

.menu-button:active {
    background-color: rgb(212, 162, 74);
    border-color: rgb(240, 205, 120);
    color: rgb(36, 27, 13);
    scale: 1.03;
}

/* the destructive path answers in red, not gold */
.menu-button.danger:hover,
.menu-button.danger:focus {
    background-color: rgb(58, 30, 24);
    border-color: rgb(196, 74, 74);
    color: rgb(255, 236, 230);
}

.menu-button.danger:active {
    background-color: rgb(196, 74, 74);
    border-color: rgb(224, 120, 110);
    color: rgb(36, 13, 10);
}

.confirm-text {
    font-size: 16px;
    color: rgb(236, 228, 211);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 4px 0 16px 0;
}

.confirm-buttons {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    align-self: stretch;
}

.confirm-buttons .menu-button {
    width: 38%;
    min-width: 150px;
    margin: 0 8px;
}
