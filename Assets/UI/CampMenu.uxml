<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="CampMenu.uss" />
    <ui:VisualElement class="camp-root">
        <ui:VisualElement name="menu-container" class="menu-container">
            <ui:Button name="return-button" class="menu-button" text="Start" />
            <ui:Button name="quests-button" class="menu-button" text="Quests" />
            <ui:Button name="stats-button" class="menu-button" text="Stats" />
            <ui:Button name="reset-button" class="menu-button danger" text="Reset All Data" />
            <ui:Button name="exit-button" class="menu-button secondary" text="Exit" />
        </ui:VisualElement>

        <ui:VisualElement name="quest-panel" class="quest-panel" style="display: none;">
            <ui:VisualElement name="quest-panel-header" class="quest-panel-header">
                <ui:Label text="Quests" class="quest-panel-title" />
                <ui:Button name="quest-close-button" class="quest-close-button" text="X" />
            </ui:VisualElement>
            <ui:VisualElement name="quest-panel-body" class="quest-panel-body">
                <ui:ScrollView name="quest-list" class="quest-list" />
                <ui:VisualElement name="quest-details" class="quest-details">
                    <ui:Label name="quest-detail-name" text="Select a quest" class="quest-detail-name" />
                    <ui:Label name="quest-detail-description" text="" class="quest-detail-description" />
                    <ui:Label name="quest-detail-progress" text="" class="quest-detail-progress" />
                    <ui:Label name="quest-detail-reward" text="" class="quest-detail-reward" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="stats-panel" class="quest-panel stats-panel" style="display: none;">
            <ui:VisualElement class="quest-panel-header">
                <ui:Label text="Stats" class="quest-panel-title" />
                <ui:Button name="stats-close-button" class="quest-close-button" text="X" />
            </ui:VisualElement>
            <ui:ScrollView name="stats-list" class="stats-list" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
