<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="CampMenu.uss" />
    <!-- Shared with the pause screen, which shows the same two panels -->
    <ui:Template name="QuestOverlay" src="QuestOverlay.uxml" />
    <ui:Template name="EquipmentOverlay" src="EquipmentOverlay.uxml" />
    <ui:VisualElement name="camp-root" class="camp-root">
        <ui:VisualElement name="layout-root" class="layout-root">
            <!-- Left Knight Status Panel -->
            <ui:VisualElement name="knight-status" class="status-panel left">
                <ui:Label text="The Knight" class="status-title" />
                <ui:Label text="Gold: 0" name="gold-line" class="stat-line" />
                <!-- Count then icon, never the word "crystals" — filled by CrystalText -->
                <ui:VisualElement name="crystal-line" class="stat-line crystal-amount">
                    <ui:Label text="0" class="crystal-amount-count" />
                    <ui:VisualElement class="crystal-amount-icon" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Center Content: Camp Menu -->
            <ui:VisualElement name="center-content" class="center-content">
                <ui:Label text="Camp" class="camp-title" />
                <ui:VisualElement class="title-ornament">
                    <ui:VisualElement class="ornament-rule" />
                    <ui:VisualElement class="ornament-diamond" />
                    <ui:VisualElement class="ornament-rule" />
                </ui:VisualElement>
                <ui:VisualElement name="menu-container" class="menu-container">
                    <ui:Button name="return-button" class="menu-button primary" text="Start" />
                    <ui:Button name="quests-button" class="menu-button" text="Quests">
                        <!-- Unread marker: halo first so the dot draws over it.
                             Both pulse from CampMenuController. -->
                        <ui:VisualElement name="quests-badge-glow" class="menu-badge-glow" style="display: none;" />
                        <ui:VisualElement name="quests-badge" class="menu-badge" style="display: none;" />
                    </ui:Button>
                    <ui:Button name="equipment-button" class="menu-button" text="Equipment">
                        <!-- Lit while something owned has not been looked at -->
                        <ui:VisualElement name="equipment-badge-glow" class="menu-badge-glow" style="display: none;" />
                        <ui:VisualElement name="equipment-badge" class="menu-badge" style="display: none;" />
                    </ui:Button>
                    <!-- Hidden until the first crystal is earned; CampMenuController
                         reveals it and lights the badge the first time it appears. -->
                    <ui:Button name="shop-button" class="menu-button" text="Shop" style="display: none;">
                        <ui:VisualElement name="shop-badge-glow" class="menu-badge-glow" style="display: none;" />
                        <ui:VisualElement name="shop-badge" class="menu-badge" style="display: none;" />
                    </ui:Button>
                    <!-- Hidden: revealed by LT+RT+LB+RB (or F9), same combo as Test Mode -->
                    <ui:Button name="stats-button" class="menu-button" text="Stats" style="display: none;" />
                    <ui:Button name="reset-button" class="menu-button danger" text="Reset All Data" style="display: none;" />
                    <ui:Button name="exit-button" class="menu-button secondary" text="Exit" />
                    <!-- Hidden dev button: revealed by LT+RT+LB+RB (or F9) in editor/dev builds -->
                    <ui:Button name="test-button" class="menu-button test" text="Test Mode" style="display: none;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Right Campaign Status Panel -->
            <ui:VisualElement name="campaign-status" class="status-panel right">
                <ui:Label text="The Campaign" class="status-title" />
                <ui:Label text="Furthest Wave: 1" name="wave-line" class="stat-line" />
                <ui:Label text="Quests: 0 / 0" name="quests-line" class="stat-line" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- File Select Overlay: the first thing shown on a fresh launch.
             Three horizontal bars, one per save file, built in code from
             SaveManager.PeekSlot. No close button — this is the boot screen,
             so there is nothing behind it to go back to. -->
        <ui:VisualElement name="file-select-panel" class="overlay-panel file-select-panel" style="display: none;">
            <ui:VisualElement class="overlay-header">
                <ui:Label text="Choose Your File" class="overlay-title" />
            </ui:VisualElement>
            <ui:VisualElement name="file-slot-column" class="file-slot-column" />
            <ui:Label text="&#9650;&#9660; choose   A begin" class="map-hint-line" />
        </ui:VisualElement>

        <!-- Quests Overlay -->
        <ui:Instance template="QuestOverlay" class="overlay-host" />

        <!-- Stats Overlay -->
        <ui:VisualElement name="stats-panel" class="overlay-panel" style="display: none;">
            <ui:VisualElement class="overlay-header">
                <ui:Label text="Stats" class="overlay-title" />
                <ui:Button name="stats-close-button" class="overlay-close-button" text="X" />
            </ui:VisualElement>
            <ui:ScrollView name="stats-list" class="stats-list" />
        </ui:VisualElement>

        <!-- Level Select Overlay (panes are built in code from the MapCatalog) -->
        <ui:VisualElement name="map-select-panel" class="overlay-panel map-select-panel" style="display: none;">
            <ui:VisualElement class="overlay-header">
                <ui:Label text="Choose Your Ground" class="overlay-title" />
                <ui:Button name="map-close-button" class="overlay-close-button" text="X" />
            </ui:VisualElement>
            <ui:VisualElement name="map-pane-row" class="map-pane-row" />
            <ui:Label text="&#9664;&#9654; choose   A begin   B back" class="map-hint-line" />
        </ui:VisualElement>

        <!-- Equipment Overlay (columns and slot rows are built in code) -->
        <ui:Instance template="EquipmentOverlay" class="overlay-host" />

        <!-- Shop Overlay (rows are built in code from the EquipmentCatalog) -->
        <ui:VisualElement name="shop-panel" class="overlay-panel" style="display: none;">
            <ui:VisualElement class="overlay-header">
                <ui:Label text="Shop" class="overlay-title" />
                <ui:Button name="shop-close-button" class="overlay-close-button" text="X" />
            </ui:VisualElement>
            <ui:VisualElement name="shop-crystals" class="shop-crystals crystal-amount">
                <ui:Label text="0" class="crystal-amount-count" />
                <ui:VisualElement class="crystal-amount-icon" />
            </ui:VisualElement>
            <ui:VisualElement name="shop-tabs" class="shop-tabs">
                <ui:Label name="shop-tab-equipment" text="EQUIPMENT" class="shop-tab" />
                <ui:Label name="shop-tab-specials" text="SPECIALS" class="shop-tab" />
            </ui:VisualElement>
            <ui:ScrollView name="shop-list" class="shop-list" />
            <ui:Label name="shop-detail" text="" class="equipment-detail" />
            <ui:Label text="&#9664;&#9654; tab   &#9650;&#9660; browse   A buy   B back" class="map-hint-line" />
        </ui:VisualElement>

        <!-- Test Mode Overlay (dev builds only; rows are built in code) -->
        <ui:VisualElement name="test-panel" class="overlay-panel" style="display: none;">
            <ui:VisualElement class="overlay-header">
                <ui:Label text="Test Mode" class="overlay-title" />
                <ui:Button name="test-close-button" class="overlay-close-button" text="X" />
            </ui:VisualElement>
            <ui:VisualElement name="test-wave-row" class="test-row">
                <ui:Label text="Starting Wave" class="test-row-name" />
                <ui:Label name="test-wave-value" text="&#9664; 1 &#9654;" class="test-row-value" />
            </ui:VisualElement>
            <ui:VisualElement name="test-map-row" class="test-row">
                <ui:Label text="Map" class="test-row-name" />
                <ui:Label name="test-map-value" text="&#9664; The Camp Fields &#9654;" class="test-row-value" />
            </ui:VisualElement>
            <ui:Label name="test-budget-line" text="" class="test-budget-line" />
            <ui:ScrollView name="test-upgrade-list" class="test-upgrade-list" />
            <ui:VisualElement name="test-start-row" class="test-row test-start-row">
                <ui:Label name="test-start-label" text="Begin Run" class="test-start-label" />
            </ui:VisualElement>
            <ui:Label text="&#9650;&#9660; move   A expand / choose   &#9664; toggle Left Knight   &#9654; toggle Right Knight   Start jump to Begin Run   B back" class="test-hint-line" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
