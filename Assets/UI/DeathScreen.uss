/* ============================================================
   Death screen — Gilded Vigil. Dark scrim over the battlefield,
   one raised panel, gold owns the primary action.
   ============================================================ */

.death-overlay {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 8, 5, 0.78);
}

.death-panel {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 46%;
    min-width: 520px;
    max-width: 720px;
    padding: 48px 40px 40px 40px;
    border-radius: 8px;
    background-color: rgb(33, 26, 16);
    border-width: 1px;
    border-color: rgb(58, 50, 34);
}

.death-message {
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    font-size: 34px;
    color: rgb(236, 228, 211);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 100%;
    margin-bottom: 28px;
}

/* ---------- run summary (gold + wave) ---------- */

.run-summary {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 34px;
}

.summary-block {
    flex-direction: column;
    align-items: center;
}

.summary-divider {
    width: 1px;
    height: 44px;
    background-color: rgb(45, 38, 23);
    margin: 0 30px;
}

.summary-caption {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(141, 130, 102);
    margin-bottom: 4px;
}

.summary-amount {
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    font-size: 46px;
    color: rgb(212, 162, 74);
}

/* ---------- actions ---------- */

.death-actions {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.death-button {
    min-width: 200px;
    padding: 12px 20px;
    margin: 0 10px;
    border-radius: 6px;
    border-width: 2px;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.15s;
}

.death-button.primary {
    background-color: rgb(212, 162, 74);
    border-color: rgb(212, 162, 74);
    color: rgb(36, 27, 13);
}

.death-button.secondary {
    background-color: rgb(28, 22, 14);
    border-color: rgb(58, 50, 34);
    color: rgb(217, 207, 184);
}

.death-button.primary:hover,
.death-button.primary:focus {
    background-color: rgb(240, 205, 120);
    border-color: rgb(255, 232, 170);
    color: rgb(36, 27, 13);
    scale: 1.04;
}

.death-button.secondary:hover,
.death-button.secondary:focus {
    background-color: rgb(41, 33, 20);
    border-color: rgb(212, 162, 74);
    color: rgb(236, 228, 211);
    scale: 1.04;
}

.death-button:active {
    background-color: rgb(240, 205, 120);
    border-color: rgb(255, 232, 170);
    color: rgb(36, 27, 13);
    scale: 1.02;
}
