/* ============================================================
   Gilded Vigil — warm near-black ground, one aged-gold accent.
   Surfaces separate by value (ground → panel → card → lifted),
   not by heavy outlines. Gold owns every interactive state.
   ============================================================ */

.upgrade-menu {
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    background-color: rgb(22, 18, 12);
}

.layout-root {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: 2%;
}

.center-content {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    width: 56%;
    min-width: 560px;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    padding: 2% 3%;
}

/* ---------- side status panels (frameless: value + one divider, no boxes) ---------- */

.status-panel {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    width: 21%;
    min-width: 240px;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    padding: 1.5%;
}

.status-panel.left { margin-right: 1%; }
.status-panel.right { margin-left: 1%; }

.status-title {
    align-self: stretch;
    -unity-text-align: upper-center;
    font-size: 20px;
    color: rgb(212, 162, 74);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    letter-spacing: 2px;
    padding-bottom: 7px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
}

.status-subtitle {
    align-self: center;
    font-size: 12px;
    color: rgb(141, 130, 102);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-top: 12px;
    margin-bottom: 4px;
}

.stat-line {
    align-self: stretch;
    -unity-text-align: upper-center;
    font-size: 14px;
    color: rgb(217, 207, 184);
    margin: 2px 0;
}

.upgrades-list {
    flex-grow: 1;
    margin-top: 6px;
    align-content: flex-start;
    background-color: rgb(28, 22, 14);
    border-radius: 4px;
    border-width: 0;
    padding: 4px;
}

/* ---------- heading / status line ---------- */

.selection-status {
    font-size: 25px;
    color: rgb(236, 228, 211);
    -unity-text-align: middle-center;
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    max-width: 100%;
    white-space: normal;
    margin-bottom: 4px;
}

/* ---------- card column ---------- */

.menu-items {
    flex-direction: column;
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    padding: 1% 2%;
    border-width: 0;
    justify-content: flex-start;
}

.upgrade-column {
    flex-direction: column;
    justify-content: flex-start;
    min-width: 100%;
    align-items: center;
    align-self: center;
    flex-shrink: 0;
}

.menu-item {
    margin: 0;
    border-width: 2px;
    border-radius: 4px;
    color: rgb(236, 228, 211);
    transition-property: background-color, border-color, translate, scale, opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    padding: 10px 16px 9px 16px;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    flex-shrink: 0;
}

.menu-item.upgrade {
    width: 100%;
    min-width: 0;
    background-color: rgb(33, 26, 16);
    border-color: rgb(58, 50, 34);
    margin: 6px auto;
}

/* ---------- card anatomy ---------- */

.card-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.upgrade-title {
    font-size: 18px;
    color: rgb(242, 234, 217);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    -unity-text-align: upper-left;
    margin: 0;
    padding: 0;
    flex-shrink: 1;
}

.upgrade-description {
    font-size: 13px;
    color: rgb(179, 168, 143);
    -unity-font-style: normal;
    -unity-text-align: upper-left;
    flex-grow: 1;
    white-space: normal;
    margin-bottom: 2px;
}

.rarity-badge {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
    flex-shrink: 0;
}

.rarity-diamond {
    width: 7px;
    height: 7px;
    rotate: 45deg;
    border-radius: 1px;
    margin-right: 7px;
}

.upgrade-rarity {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

/* rarity keeps its own semantic colors; size never changes */
.menu-item.common .upgrade-rarity { color: rgb(176, 141, 87); }
.menu-item.rare .upgrade-rarity { color: rgb(168, 198, 221); }
.menu-item.epic .upgrade-rarity { color: rgb(227, 179, 65); }
.menu-item.legendary .upgrade-rarity { color: rgb(177, 138, 224); }

.menu-item.common .rarity-diamond { background-color: rgb(176, 141, 87); }
.menu-item.rare .rarity-diamond { background-color: rgb(168, 198, 221); }
.menu-item.epic .rarity-diamond { background-color: rgb(227, 179, 65); }
.menu-item.legendary .rarity-diamond { background-color: rgb(177, 138, 224); }

/* ---------- chain progress footer ---------- */

.chain-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 5px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgb(45, 38, 23);
}

.chain-pips {
    flex-direction: row;
    align-items: center;
}

.pip {
    width: 8px;
    height: 8px;
    rotate: 45deg;
    border-radius: 1px;
    margin-right: 7px;
}

.pip--owned { background-color: rgb(212, 162, 74); }

.pip--offered {
    background-color: transparent;
    border-width: 2px;
    border-color: rgb(212, 162, 74);
}

.pip--future { background-color: rgb(61, 53, 36); }

.chain-label {
    font-size: 11px;
    color: rgb(141, 130, 102);
    letter-spacing: 1px;
    -unity-text-align: middle-right;
}

/* ---------- interactive states (gold owns them all) ---------- */

.menu-item--selected { border-color: rgb(212, 162, 74); }

/* focused card slides right on a transform — no reflow, neighbors stay put */
.menu-item.upgrade.menu-item--selected {
    background-color: rgb(42, 33, 19);
    border-color: rgb(212, 162, 74);
    translate: 8px 0;
}

.menu-item--chosen { border-color: rgb(240, 205, 120); }

.menu-item.upgrade.menu-item--chosen {
    background-color: rgb(51, 40, 21);
    border-color: rgb(240, 205, 120);
}

.menu-item.upgrade.menu-item--chosen .upgrade-title { color: rgb(255, 248, 230); }

.menu-item.upgrade.menu-item--chosen.menu-item--selected {
    background-color: rgb(51, 40, 21);
    border-color: rgb(240, 205, 120);
}

/* ---------- confirm button ---------- */

.menu-item.confirm {
    background-color: rgb(212, 162, 74);
    border-color: rgb(212, 162, 74);
    color: rgb(36, 27, 13);
    margin: 14px auto 8px auto;
}

.confirm-button {
    width: 50%;
    min-width: 220px;
    max-width: 350px;
    align-self: center;
    padding: 10px 0;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.confirm-button.menu-item--selected {
    background-color: rgb(240, 205, 120);
    border-color: rgb(255, 232, 170);
    color: rgb(36, 27, 13);
    scale: 1.04;
}

/* ---------- animation helper states (toggled from UpgradeMenu.cs) ---------- */

/* quick press pulse: class is added then removed ~90ms later */
.menu-item--punch { transition-duration: 0.07s; }
.menu-item.upgrade.menu-item--punch { scale: 1.02; }
.confirm-button.menu-item--punch { scale: 1.12; }

/* confirm flash on the chosen card while the confirm delay plays out */
.menu-item.upgrade.menu-item--confirm-flash {
    border-color: rgb(255, 236, 180);
    background-color: rgb(72, 56, 27);
}

/* entrance: cards start here, class removal staggers them into place */
.card-enter {
    opacity: 0;
    translate: 0 16px;
}
