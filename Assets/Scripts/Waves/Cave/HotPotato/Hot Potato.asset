%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c1797657f96f40129355167b5f7fd342, type: 3}
  m_Name: Hot Potato
  m_EditorClassIdentifier: 
  waveName: Hot Potato
  weight: 1000
  isUnlocked: 0
  waveDescription: Four fire ogres at once, twice. The rock comes in spirals.
  unlockedAfterXWaves: 1
  lockedAfterXWaves: 6
  useEnemyTracking: 1
  crossings:
  - label: 'group 1: 4 fire ogres, over the top first'
    ogres:
      label: 4 fire ogres at once, 2 on top and 2 below
      count: 4
      firstAt: 1.5
      interval: 0
      throwStagger: 2.5
      fireEveryNth: 1
      entries:
      - label: over the top, right of centre, walking at the left knight
        at: {x: 3.5, y: 6.5}
        mark: 1
      - label: over the top, left of centre, walking at the right knight
        at: {x: -3.5, y: 6.5}
        mark: 2
      - label: up from under, right of centre, walking at the left knight
        at: {x: 3.5, y: -7}
        mark: 1
      - label: up from under, left of centre, walking at the right knight
        at: {x: -3.5, y: -7}
        mark: 2
      startOnRight: 0
      entryX: 11
      entryY: -0.5
      laneStep: 1.1
    firstVolleyAt: 3
    volleys:
    - label: spiral round the left knight, from over the top
      shape: 8
      rightKnight: 0
      fromBelow: 0
      spacing: 0.5
      count: 6
      fanDegrees: 60
      weaveDegrees: 90
      spiralDegrees: 180
      spiralPasses: 1
      salvo: 1
      salvoSpread: 0.45
      salvoStagger: 0.1
      restAfter: 2.5
    - label: spiral round the right knight, from underneath
      shape: 8
      rightKnight: 1
      fromBelow: 1
      spacing: 0.5
      count: 6
      fanDegrees: 60
      weaveDegrees: 90
      spiralDegrees: 180
      spiralPasses: 1
      salvo: 1
      salvoSpread: 0.45
      salvoStagger: 0.1
      restAfter: 2.5
  - label: 'group 2: 4 fire ogres, up from under first'
    ogres:
      label: 4 fire ogres at once, 2 on top and 2 below
      count: 4
      firstAt: 1.5
      interval: 0
      throwStagger: 2.5
      fireEveryNth: 1
      entries:
      - label: up from under, right of centre, walking at the left knight
        at: {x: 3.5, y: -7}
        mark: 1
      - label: up from under, left of centre, walking at the right knight
        at: {x: -3.5, y: -7}
        mark: 2
      - label: over the top, right of centre, walking at the left knight
        at: {x: 3.5, y: 6.5}
        mark: 1
      - label: over the top, left of centre, walking at the right knight
        at: {x: -3.5, y: 6.5}
        mark: 2
      startOnRight: 0
      entryX: 11
      entryY: -0.5
      laneStep: 1.1
    firstVolleyAt: 3
    volleys:
    - label: spiral round the right knight, from underneath
      shape: 8
      rightKnight: 1
      fromBelow: 1
      spacing: 0.5
      count: 6
      fanDegrees: 60
      weaveDegrees: 90
      spiralDegrees: 180
      spiralPasses: 1
      salvo: 1
      salvoSpread: 0.45
      salvoStagger: 0.1
      restAfter: 2.5
    - label: spiral round the left knight, from over the top
      shape: 8
      rightKnight: 0
      fromBelow: 0
      spacing: 0.5
      count: 6
      fanDegrees: 60
      weaveDegrees: 90
      spiralDegrees: 180
      spiralPasses: 1
      salvo: 1
      salvoSpread: 0.45
      salvoStagger: 0.1
      restAfter: 2.5
  rockSpeed: 1.75
  healthOrbs:
    healthOrb: 1
    count: 1
    firstAt: 12
    interval: 12
    from: {x: -12, y: 4}
    to: {x: 12, y: 4}
  manaOrbs:
    healthOrb: 0
    count: 0
    firstAt: 30
    interval: 20
    from: {x: 12, y: -4}
    to: {x: -12, y: -4}
