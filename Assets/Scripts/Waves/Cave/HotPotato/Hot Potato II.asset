  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c1797657f96f40129355167b5f7fd342, type: 3}
  m_Name: Hot Potato II
  m_EditorClassIdentifier: 
  waveName: Hot Potato II
  weight: 1000
  isUnlocked: 0
  waveDescription: Five fire ogres at a time, three from above and two from below.
  unlockedAfterXWaves: 4
  lockedAfterXWaves: 10
  useEnemyTracking: 1
  crossings:
  - label: 'group 1: 5 fire ogres, over the top first'
    ogres:
      label: 5 fire ogres at once, 3 on top and 2 below
      count: 5
      firstAt: 1.5
      interval: 0
      throwStagger: 2
      fireEveryNth: 1
      entries:
      - label: over the top, in the middle, walking at the left knight
        at: {x: 0, y: 6.5}
        mark: 1
      - label: over the top, left of centre, walking at the right knight
        at: {x: -4.5, y: 6.5}
        mark: 2
      - label: up from under, right of centre, walking at the left knight
        at: {x: 3.5, y: -7}
        mark: 1
      - label: up from under, left of centre, walking at the right knight
        at: {x: -3.5, y: -7}
        mark: 2
      - label: over the top, right of centre, walking at the left knight
        at: {x: 4.5, y: 6.5}
        mark: 1
      startOnRight: 0
      entryX: 11
      entryY: -0.5
      laneStep: 1.1
    firstVolleyAt: 3
    volleys:
    - label: both knights spiral from over the top, mirrored
      shape: 9
      rightKnight: 0
      fromBelow: 0
      spacing: 0.4
      count: 6
      fanDegrees: 60
      weaveDegrees: 90
      spiralDegrees: 180
      spiralPasses: 1
      salvo: 3
      salvoSpread: 0.45
      salvoStagger: 0.08
      restAfter: 5
    - label: the left knight, low quarter, there and back
      shape: 8
      rightKnight: 0
      fromBelow: 1
      spacing: 0.4
      count: 4
      fanDegrees: 60
      weaveDegrees: 90
      spiralDegrees: 120
      spiralPasses: 2
      salvo: 3
      salvoSpread: 0.45
      salvoStagger: 0.08
      restAfter: 0.3
    - label: the right knight, low quarter, there and back
      shape: 8
      rightKnight: 1
      fromBelow: 1
      spacing: 0.4
      count: 4
      fanDegrees: 60
      weaveDegrees: 90
      spiralDegrees: 120
      spiralPasses: 2
      salvo: 3
      salvoSpread: 0.45
      salvoStagger: 0.08
      restAfter: 5
  - label: 'group 2: 5 fire ogres, up from under first'
    ogres:
      label: 5 fire ogres at once, 3 on top and 2 below
      count: 5
      firstAt: 1.5
      interval: 0
      throwStagger: 2
      fireEveryNth: 1
