/* ============================================================
   Gilded Vigil — warm near-black ground, one aged-gold accent.
   Surfaces separate by value (ground → panel → card → lifted),
   not by heavy outlines. Gold owns every interactive state.
   Same system as UpgradeMenu.uss.
   ============================================================ */

.camp-root {
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    background-color: rgb(22, 18, 12);
}

.layout-root {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: 2%;
}

.center-content {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 56%;
    min-width: 560px;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    padding: 2% 3%;
}

/* ---------- side status panels (frameless: value + one divider, no boxes) ---------- */

.status-panel {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    width: 21%;
    min-width: 240px;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    padding: 1.5%;
}

.status-panel.left { margin-right: 1%; }
.status-panel.right { margin-left: 1%; }

.status-title {
    align-self: stretch;
    -unity-text-align: upper-center;
    font-size: 20px;
    color: rgb(212, 162, 74);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    letter-spacing: 2px;
    padding-bottom: 7px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
}

.stat-line {
    align-self: stretch;
    -unity-text-align: upper-center;
    font-size: 14px;
    color: rgb(217, 207, 184);
    margin: 2px 0;
}

/* ---------- title ---------- */

.camp-title {
    font-size: 34px;
    color: rgb(236, 228, 211);
    -unity-text-align: middle-center;
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    letter-spacing: 4px;
}

.title-ornament {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    margin-bottom: 22px;
}

.ornament-rule {
    width: 64px;
    height: 1px;
    background-color: rgb(45, 38, 23);
}

.ornament-diamond {
    width: 7px;
    height: 7px;
    rotate: 45deg;
    border-radius: 1px;
    background-color: rgb(212, 162, 74);
    margin: 0 10px;
}

/* ---------- menu column (buttons follow the card anatomy) ---------- */

.menu-container {
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: 420px;
    align-self: center;
}

.menu-button {
    width: 100%;
    margin: 5px 0;
    padding: 13px 18px;
    background-color: rgb(33, 26, 16);
    border-width: 2px;
    border-radius: 4px;
    border-color: rgb(58, 50, 34);
    color: rgb(217, 207, 184);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color, translate, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* focused button slides right on a transform — no reflow, neighbors stay put */
.menu-button.menu-button--selected {
    background-color: rgb(42, 33, 19);
    border-color: rgb(212, 162, 74);
    color: rgb(242, 234, 217);
    translate: 8px 0;
}

/* primary action is solid gold, like the upgrade confirm button */
.menu-button.primary {
    background-color: rgb(212, 162, 74);
    border-color: rgb(212, 162, 74);
    color: rgb(36, 27, 13);
}

.menu-button.primary.menu-button--selected {
    background-color: rgb(240, 205, 120);
    border-color: rgb(255, 232, 170);
    color: rgb(36, 27, 13);
    translate: 0 0;
    scale: 1.04;
}

/* quiet exit: recedes into the ground until focused */
.menu-button.secondary {
    background-color: transparent;
    border-color: rgb(45, 38, 23);
    color: rgb(141, 130, 102);
}

.menu-button.secondary.menu-button--selected {
    background-color: rgb(42, 33, 19);
    border-color: rgb(212, 162, 74);
    color: rgb(242, 234, 217);
}

/* danger keeps a muted ember identity; gold still takes over on focus */
.menu-button.danger {
    background-color: rgb(33, 26, 16);
    border-color: rgb(74, 40, 28);
    color: rgb(205, 133, 105);
}

.menu-button.danger.menu-button--selected {
    background-color: rgb(42, 33, 19);
    border-color: rgb(212, 162, 74);
    color: rgb(216, 148, 120);
}

/* first press arms the wipe; second press confirms */
.menu-button.danger.menu-button--armed,
.menu-button.danger.menu-button--armed.menu-button--selected {
    background-color: rgb(96, 32, 20);
    border-color: rgb(226, 120, 63);
    color: rgb(255, 235, 225);
}

/* ---------- overlay panels (quests / stats) ---------- */

.overlay-panel {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 10%;
    bottom: 10%;
    background-color: rgb(28, 22, 14);
    border-width: 0;
    border-radius: 6px;
    padding: 22px 26px;
    flex-direction: column;
}

.overlay-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 10px;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
}

.overlay-title {
    font-size: 22px;
    color: rgb(212, 162, 74);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    letter-spacing: 2px;
}

.overlay-close-button {
    width: 34px;
    height: 34px;
    padding: 0;
    margin: 0;
    background-color: transparent;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(58, 50, 34);
    color: rgb(141, 130, 102);
    font-size: 14px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.overlay-close-button:hover,
.overlay-close-button:focus {
    background-color: rgb(42, 33, 19);
    border-color: rgb(212, 162, 74);
    color: rgb(212, 162, 74);
}

/* ---------- quest overlay body ---------- */

.quest-panel-body {
    flex-direction: row;
    flex-grow: 1;
}

/* the list is a well: it drops back to the ground value */
.quest-list {
    width: 34%;
    min-width: 220px;
    margin-right: 16px;
    background-color: rgb(22, 18, 12);
    border-width: 0;
    border-radius: 4px;
    padding: 4px;
}

.quest-list-item {
    margin: 0;
    padding: 12px 14px;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    border-left-width: 2px;
    border-left-color: transparent;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
    font-size: 14px;
    color: rgb(217, 207, 184);
    -unity-text-align: middle-left;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.quest-list-item:hover {
    background-color: rgb(33, 26, 16);
}

.quest-list-item--selected {
    background-color: rgb(42, 33, 19);
    border-left-color: rgb(212, 162, 74);
    color: rgb(242, 234, 217);
    -unity-font-style: bold;
}

.quest-list-item--completed {
    color: rgb(141, 130, 102);
    -unity-font-style: italic;
}

.quest-list-item--completed.quest-list-item--selected {
    color: rgb(179, 168, 143);
}

.quest-details {
    flex-grow: 1;
    background-color: rgb(33, 26, 16);
    border-width: 0;
    border-radius: 4px;
    padding: 20px;
    flex-direction: column;
}

.quest-detail-name {
    font-size: 22px;
    color: rgb(242, 234, 217);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    margin-bottom: 10px;
    white-space: normal;
}

.quest-detail-description {
    font-size: 14px;
    color: rgb(179, 168, 143);
    white-space: normal;
    flex-grow: 1;
    margin-bottom: 10px;
}

.quest-detail-progress {
    font-size: 13px;
    color: rgb(217, 207, 184);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.quest-detail-reward {
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.quest-detail-reward--active {
    color: rgb(212, 162, 74);
}

.quest-detail-reward--completed {
    color: rgb(240, 205, 120);
}

/* ---------- level select ----------
   Tall panes side by side: artwork on top, name plate beneath. The selected
   pane is the only lit one — everything else drops toward the ground value so
   the cursor is unmistakable at a glance across the room. */

.map-select-panel {
    left: 6%;
    right: 6%;
    top: 8%;
    bottom: 8%;
}

.map-pane-row {
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    flex-grow: 1;
    padding: 10px 0;
}

.map-pane {
    flex-direction: column;
    align-items: stretch;
    width: 260px;
    max-width: 30%;
    margin: 0 12px;
    padding: 10px;
    background-color: rgb(28, 22, 14);
    border-width: 2px;
    border-radius: 5px;
    border-color: rgb(58, 50, 34);
    transition-property: background-color, border-color, scale, opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    opacity: 0.72;
}

.map-pane--selected {
    background-color: rgb(42, 33, 19);
    border-color: rgb(212, 162, 74);
    scale: 1.04;
    opacity: 1;
}

/* the artwork well: recessed, and it owns most of the pane's height */
.map-pane-image {
    flex-grow: 1;
    min-height: 180px;
    margin-bottom: 10px;
    border-radius: 3px;
    background-color: rgb(22, 18, 12);
    -unity-background-scale-mode: scale-and-crop;
}

/* locked maps read as unlit stone — the art is there but drained */
.map-pane--locked .map-pane-image {
    opacity: 0.28;
}

.map-pane-name {
    -unity-text-align: middle-center;
    font-size: 18px;
    color: rgb(217, 207, 184);
    -unity-font-definition: url("Fonts/Alegreya-Bold.ttf");
    -unity-font-style: normal;
    letter-spacing: 2px;
    white-space: normal;
}

.map-pane--selected .map-pane-name {
    color: rgb(242, 234, 217);
}

.map-pane--locked .map-pane-name {
    color: rgb(141, 130, 102);
}

.map-pane-tagline {
    -unity-text-align: middle-center;
    font-size: 12px;
    color: rgb(141, 130, 102);
    margin-top: 4px;
    white-space: normal;
}

.map-pane-status {
    -unity-text-align: middle-center;
    font-size: 12px;
    color: rgb(212, 162, 74);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 8px;
    padding-top: 7px;
    border-top-width: 1px;
    border-top-color: rgb(45, 38, 23);
}

.map-pane-status--locked {
    color: rgb(122, 112, 88);
}

.map-pane-status--cleared {
    color: rgb(240, 205, 120);
}

.map-hint-line {
    font-size: 11px;
    color: rgb(141, 130, 102);
    -unity-text-align: middle-center;
    margin-top: 6px;
}

.map-empty-line {
    font-size: 14px;
    color: rgb(141, 130, 102);
    -unity-text-align: middle-center;
    flex-grow: 1;
}

/* ---------- test mode (dev builds only) ---------- */

/* the test overlay owns the whole screen — the upgrade list is long */
#test-panel {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 0;
}

/* dev button keeps a cooler, utilitarian identity so it reads as a tool */
.menu-button.test {
    border-color: rgb(38, 52, 58);
    color: rgb(122, 160, 170);
}

.menu-button.test.menu-button--selected {
    background-color: rgb(30, 38, 40);
    border-color: rgb(122, 160, 170);
    color: rgb(196, 222, 228);
}

.test-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 14px;
    border-radius: 3px;
    border-left-width: 2px;
    border-left-color: transparent;
}

/* The wave and map rows are the panel's fixed chrome, sitting above the
   scrolling list. Without flex-shrink: 0 the tall list squeezes them until
   their labels spill over each other; they also carry more weight than a
   single upgrade row, so they get more room than one. */
#test-wave-row,
#test-map-row {
    flex-shrink: 0;
    padding: 8px 16px;
    margin-bottom: 4px;
}

.test-row--selected {
    background-color: rgb(42, 33, 19);
    border-left-color: rgb(212, 162, 74);
}

.test-row-name {
    font-size: 14px;
    color: rgb(217, 207, 184);
}

.test-row--selected .test-row-name {
    color: rgb(242, 234, 217);
    -unity-font-style: bold;
}

.test-row-value {
    font-size: 14px;
    color: rgb(212, 162, 74);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.test-budget-line {
    font-size: 13px;
    color: rgb(179, 168, 143);
    -unity-text-align: middle-center;
    margin: 6px 0;
    letter-spacing: 1px;
}

.test-budget-line--over {
    color: rgb(216, 110, 80);
    -unity-font-style: bold;
}

.test-upgrade-list {
    flex-grow: 1;
    background-color: rgb(22, 18, 12);
    border-width: 0;
    border-radius: 4px;
    padding: 4px;
}

/* Order category banner above each group of chain sections */
.test-category-header {
    font-size: 14px;
    color: rgb(212, 162, 74);
    letter-spacing: 3px;
    -unity-font-style: bold;
    padding: 16px 14px 4px 8px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(212, 162, 74);
    margin-bottom: 2px;
}

/* section headers are selectable rows that expand/collapse their chain */
.test-section-header {
    font-size: 12px;
    color: rgb(141, 130, 102);
    letter-spacing: 2px;
    -unity-font-style: bold;
    padding: 10px 14px 8px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
    border-left-width: 2px;
    border-left-color: transparent;
}

.test-section-header.test-row--selected {
    background-color: rgb(42, 33, 19);
    border-left-color: rgb(212, 162, 74);
    color: rgb(240, 205, 120);
}

/* per-knight toggle chips on each upgrade row */
.test-toggle {
    width: 34px;
    padding: 3px 0;
    margin-left: 8px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(58, 50, 34);
    background-color: transparent;
    color: rgb(141, 130, 102);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.test-toggle--on {
    background-color: rgb(212, 162, 74);
    border-color: rgb(212, 162, 74);
    color: rgb(36, 27, 13);
}

.test-start-row {
    flex-shrink: 0; /* chrome, like the wave/map rows — the list gives up the space */
    margin-top: 8px;
    padding: 11px 14px;
    background-color: rgb(33, 26, 16);
    border-width: 2px;
    border-radius: 4px;
    border-color: rgb(58, 50, 34);
    justify-content: center;
}

.test-start-row.test-row--selected {
    background-color: rgb(212, 162, 74);
    border-color: rgb(212, 162, 74);
}

.test-start-row.test-start-row--blocked {
    border-color: rgb(74, 40, 28);
}

.test-start-label {
    font-size: 15px;
    color: rgb(217, 207, 184);
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.test-start-row.test-row--selected .test-start-label {
    color: rgb(36, 27, 13);
}

.test-start-row.test-start-row--blocked .test-start-label {
    color: rgb(205, 133, 105);
}

.test-hint-line {
    font-size: 11px;
    color: rgb(141, 130, 102);
    -unity-text-align: middle-center;
    margin-top: 8px;
}

/* ---------- stats overlay body ---------- */

.stats-list {
    flex-grow: 1;
    background-color: rgb(22, 18, 12);
    border-width: 0;
    border-radius: 4px;
    padding: 4px;
}

.stats-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 38, 23);
}

.stats-label {
    font-size: 14px;
    color: rgb(217, 207, 184);
}

.stats-value {
    font-size: 14px;
    color: rgb(212, 162, 74);
    -unity-font-style: bold;
}
